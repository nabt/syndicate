#!/usr/bin/env python3
"""syndicate-install: install, upgrade, roll back and verify per-user Syndicate releases.

Run it with bytecode disabled, from a checkout (first install) or from an
installed release (later upgrades and rollbacks):

    python3 -B bin/syndicate-install install --tag vX.Y.Z --upstream URL

See docs/user-install.md.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import syndicate_release  # noqa: E402

if __name__ == "__main__":
    sys.exit(syndicate_release.main(sys.argv[1:]))
