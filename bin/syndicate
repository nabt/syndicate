#!/usr/bin/env python3
"""syndicate: run a team of role-based coding agents on Claude Code and/or Codex CLI.

Global roles live in <repo>/roles. Each project can override them, and choose
which CLI runs each role, from an untracked <project>/.syndicate/ directory.
Nothing is written anywhere else in the project. See README.md and
docs/configuration.md.
"""
from __future__ import annotations

import argparse
import http.server
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

SCRIPT = Path(__file__).resolve()
sys.path.insert(0, str(SCRIPT.parent))
import syndicate_runtime as runtime
HOME_DIR = SCRIPT.parent.parent
GLOBAL_ROLES = HOME_DIR / "roles"
GATE_SCRIPT = HOME_DIR / "hooks" / "require-review.sh"
WEB_DIR = HOME_DIR / "web"
HANDOFF_SKILL = HOME_DIR / "skills" / "syndicate-handoff" / "SKILL.md"
REGISTRY_PATH = Path.home() / ".syndicate" / "projects.json"
CLIS = ("claude", "codex")
LOCAL = ".syndicate"
ROLE_NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")
RELAY_SANDBOX = "workspace-write"
STATUS_STATES = ("running", "waiting_on_user", "done")
MAX_STATUS_HISTORY = 200

CONFIG_TEMPLATE = """\
# Local-only syndicate team config for this project (git-ignored).
# One 'key = value' per line; '#' starts a comment.
#
# default = claude        # CLI for every role not listed below: claude | codex
# orchestrator = claude   # CLI that hosts the session; other roles are delegated to from it
# code-reviewer = codex   # any role name: a global role or one defined in .syndicate/roles/
# handoff = on            # monitor quotas and checkpoint before switching providers
# handoff-reserve = 10    # percentage of account usage remaining at which to stop
# review-gate = on        # on (default) | off: block finishing until code-reviewer has reviewed
"""


class SyndicateError(Exception):
    pass


def jstr(text: str) -> str:
    """JSON string literal, which is also a valid TOML basic string."""
    return json.dumps(text, ensure_ascii=False).replace("\x7f", "\\u007f")


def split_frontmatter(text: str) -> tuple[dict, str]:
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        return {}, text
    fm = {}
    for line in m.group(1).splitlines():
        key, sep, value = line.partition(":")
        if sep and not line.startswith((" ", "#")):
            fm[key.strip()] = value.strip()
    return fm, m.group(2)


class Role:
    def __init__(self, name: str, fm: dict, body: str, sources: list[str]):
        self.name = name
        self.description = fm.get("description") or f"The {name} role."
        tools = fm.get("tools")
        self.tools = [t.strip() for t in tools.split(",") if t.strip()] if tools else None
        self.body = body.strip()
        self.sources = sources
        self.cli = "claude"

    @property
    def can_write(self) -> bool:
        return self.tools is None or bool({"Write", "Edit"} & set(self.tools))

    @property
    def sandbox(self) -> str:
        return "workspace-write" if self.can_write else "read-only"


class Team:
    def __init__(self, project: Path, roles: dict[str, Role], config: dict, warnings: list[str], host: str):
        self.project = project
        self.roles = roles
        self.config = config
        self.warnings = warnings
        self.host = host

    @property
    def gate(self) -> bool:
        return self.config["review-gate"] == "on"


def load_roles(project: Path) -> tuple[dict[str, Role], list[str]]:
    parsed: dict[str, dict] = {}
    warnings: list[str] = []
    for f in sorted(GLOBAL_ROLES.glob("*.md")):
        fm, body = split_frontmatter(f.read_text())
        parsed[f.stem] = {"fm": fm, "body": body, "sources": ["global"]}

    local = project / LOCAL / "roles"
    if local.is_dir():
        for f in sorted(local.glob("*.md")):
            if f.name.endswith(".append.md"):
                continue
            if not ROLE_NAME.match(f.stem):
                warnings.append(f"ignoring {f}: role names are lowercase letters, digits and dashes")
                continue
            fm, body = split_frontmatter(f.read_text())
            base = parsed.get(f.stem)
            merged = dict(base["fm"]) if base else {}
            merged.update(fm)
            parsed[f.stem] = {"fm": merged, "body": body, "sources": ["project override" if base else "project"]}
        for f in sorted(local.glob("*.append.md")):
            name = f.name[: -len(".append.md")]
            if name not in parsed:
                warnings.append(f"ignoring {f}: no role named '{name}' to append to")
                continue
            _, extra = split_frontmatter(f.read_text())
            parsed[name]["body"] = parsed[name]["body"].rstrip() + "\n\n## Project-Specific Guidance\n\n" + extra.strip()
            parsed[name]["sources"].append("appended")

    roles = {n: Role(n, p["fm"], p["body"], p["sources"]) for n, p in parsed.items()}
    return roles, warnings


def load_config(project: Path, roles: dict[str, Role]) -> dict:
    config = {"default": os.environ.get("SYNDICATE_RUNTIME") or "claude", "review-gate": "on", "handoff": "on", "handoff-reserve": "10"}
    if config["default"] not in CLIS:
        raise SyndicateError(f"SYNDICATE_RUNTIME must be one of {', '.join(CLIS)}")
    path = project / LOCAL / "config"
    if path.is_file():
        for n, raw in enumerate(path.read_text().splitlines(), 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            key, sep, value = (p.strip() for p in line.partition("="))
            where = f"{path}:{n}"
            if not sep or not key or not value:
                raise SyndicateError(f"{where}: expected 'key = value'")
            if key == "handoff-reserve":
                try:
                    valid = 0 < float(value) < 100
                except ValueError:
                    valid = False
                if not valid:
                    raise SyndicateError(f"{where}: handoff-reserve must be between 0 and 100 (exclusive)")
            elif key in ("review-gate", "handoff"):
                if value not in ("on", "off"):
                    raise SyndicateError(f"{where}: {key} must be on or off")
            elif key == "default" or key in roles:
                if value not in CLIS:
                    raise SyndicateError(f"{where}: cli must be one of {', '.join(CLIS)}")
            else:
                raise SyndicateError(f"{where}: unknown role '{key}' (known: {', '.join(sorted(roles))})")
            config[key] = value
    return config


def resolve_team(project: Path, host_override: str | None = None) -> Team:
    roles, warnings = load_roles(project)
    if "orchestrator" not in roles:
        raise SyndicateError("no 'orchestrator' role found")
    config = load_config(project, roles)
    for name, role in roles.items():
        role.cli = config.get(name, config["default"])
    host = host_override or roles["orchestrator"].cli
    if host not in CLIS:
        raise SyndicateError(f"unknown runtime '{host}' (use {' or '.join(CLIS)})")
    roles["orchestrator"].cli = host
    return Team(project, roles, config, warnings, host)


def git(project: Path, *args: str) -> str | None:
    r = subprocess.run(["git", "-C", str(project), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def ensure_excluded(project: Path) -> str | None:
    """Keep .syndicate/ out of git via the repo's local-only exclude file (never .gitignore)."""
    top = git(project, "rev-parse", "--show-toplevel")
    exclude = git(project, "rev-parse", "--git-path", "info/exclude")
    if not top or not exclude:
        return "not a git repository: nothing to exclude"
    exclude_path = Path(exclude) if os.path.isabs(exclude) else project / exclude
    rel = project.resolve().relative_to(Path(top).resolve()).as_posix()
    pattern = "/" + ("" if rel == "." else rel + "/") + LOCAL + "/"
    text = exclude_path.read_text() if exclude_path.exists() else ""
    if pattern not in text.splitlines():
        exclude_path.parent.mkdir(parents=True, exist_ok=True)
        with exclude_path.open("a") as f:
            if text and not text.endswith("\n"):
                f.write("\n")
            f.write(f"# syndicate: local-only team config and generated agents\n{pattern}\n")
    if git(project, "ls-files", LOCAL):
        return f"warning: {LOCAL}/ has tracked files; run 'git rm -r --cached {LOCAL}' to keep it local-only"
    return None


def generated(project: Path) -> Path:
    path = project / LOCAL / ".generated"
    path.mkdir(parents=True, exist_ok=True)
    return path


def relay_command(role: Role, project: Path) -> str:
    return f"{shlex.quote(str(SCRIPT))} run-role {role.name} -C {shlex.quote(str(project))} --runtime {role.cli} -"


def relay_prompt(role: Role, project: Path) -> str:
    return f"""\
You are a relay for the `{role.name}` role, which runs on the {role.cli} CLI in this project. You do not do the work yourself.

1. Write a complete, self-contained brief for the role from the task you were given. The role cannot see this conversation, so include the goal, constraints, relevant file paths, and what to return.
2. Run exactly this command with Bash, putting the brief in the heredoc:

{relay_command(role, project)} <<'SYNDICATE_BRIEF'
<the brief>
SYNDICATE_BRIEF

3. Reply with the command's output verbatim as your final answer. If the command fails, report the error verbatim. Do not retry a different way or do the work yourself.
"""


def orchestrator_body(team: Team) -> str:
    body = team.roles["orchestrator"].body
    if team.config["handoff"] == "on":
        body += "\n\n" + split_frontmatter(HANDOFF_SKILL.read_text())[1]
    return body


def claude_agent(role: Role) -> dict:
    agent = {"description": role.description, "prompt": role.body}
    if role.tools:
        agent["tools"] = role.tools
    return agent


def build_claude(team: Team, headless: bool, rest: list[str]) -> list[str]:
    agents, relays = {}, False
    for name, role in team.roles.items():
        if name == "orchestrator" or role.cli == "claude":
            agents[name] = claude_agent(role)
            if name == "orchestrator":
                agents[name]["prompt"] = orchestrator_body(team)
        else:
            relays = True
            agents[name] = {
                "description": role.description,
                "prompt": relay_prompt(role, team.project),
                "tools": ["Bash"],
            }
    settings: dict = {}
    if team.config["handoff"] == "on":
        settings["statusLine"] = {"type": "command", "command":
            shlex.join([sys.executable, str(SCRIPT), "_claude-usage"])}
    if team.gate:
        settings["hooks"] = {"Stop": [{"hooks": [{"type": "command", "command": shlex.quote(str(GATE_SCRIPT))}]}]}
    if relays:
        settings["permissions"] = {"allow": [f"Bash({SCRIPT} run-role *)"]}
    argv = ["claude", "--agent", "orchestrator", "--agents", json.dumps(agents)]
    if settings:
        path = generated(team.project) / "claude-settings.json"
        path.write_text(json.dumps(settings, indent=2) + "\n")
        argv += ["--settings", str(path)]
    if headless:
        argv.append("-p")
    return argv + rest


def build_codex(team: Team, headless: bool, rest: list[str]) -> list[str]:
    gen = generated(team.project) / "codex"
    gen.mkdir(parents=True, exist_ok=True)
    keep: set[str] = set()
    overrides: list[str] = []
    relays = False
    for name, role in team.roles.items():
        if name == "orchestrator":
            continue
        relays = relays or role.cli != "codex"
        if role.cli == "codex":
            instructions, sandbox = role.body, role.sandbox
        else:
            instructions, sandbox = relay_prompt(role, team.project), RELAY_SANDBOX
        f = gen / f"{name}.toml"
        f.write_text(f"developer_instructions = {jstr(instructions)}\nsandbox_mode = {jstr(sandbox)}\n")
        keep.add(f.name)
        overrides += [
            "-c", f"agents.{name}.description={jstr(role.description)}",
            "-c", f"agents.{name}.config_file={jstr(str(f))}",
        ]
    for old in gen.glob("*.toml"):
        if old.name not in keep:
            old.unlink()
    names = ", ".join(n for n in team.roles if n != "orchestrator")
    instructions = (
        orchestrator_body(team)
        + f"\n\nSpecialist roles are available as custom agents with these exact names; spawn them to delegate: {names}."
    )
    if relays:
        # Relay agents run another CLI, which must reach its API; the sandbox blocks network by default.
        overrides += ["-c", "sandbox_workspace_write.network_access=true"]
    argv = ["codex"]
    if headless:
        argv += ["exec", "-C", str(team.project), "-s", "workspace-write"]
    else:
        argv += ["-C", str(team.project)]
    return argv + ["-c", f"developer_instructions={jstr(instructions)}"] + overrides + rest


def require_clis(clis: set[str]) -> None:
    for cli in sorted(clis):
        if not shutil.which(cli):
            raise SyndicateError(f"the '{cli}' CLI is not installed or not on PATH")


# --- status & registry (bin/syndicate instruments; roles/orchestrator.md is the other writer) ---

def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def mtime_iso(path: Path) -> str | None:
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except OSError:
        return None


def load_registry() -> list[dict]:
    if not REGISTRY_PATH.is_file():
        return []
    try:
        data = json.loads(REGISTRY_PATH.read_text())
    except (json.JSONDecodeError, OSError):
        return []
    return data.get("projects", []) if isinstance(data, dict) else []


def register_project(project: Path) -> None:
    """Record this project in the user-wide registry so dashboard/web can find it
    without being pointed at it explicitly."""
    path_str = str(project)
    projects = [p for p in load_registry() if p.get("path") != path_str]
    projects.insert(0, {"path": path_str, "name": project.name, "last_seen": now_iso()})
    REGISTRY_PATH.parent.mkdir(parents=True, exist_ok=True)
    REGISTRY_PATH.write_text(json.dumps({"projects": projects}, indent=2) + "\n")


def status_path(project: Path) -> Path:
    return project / LOCAL / "status.json"


def write_status_stub(project: Path, pid: int, summary: str) -> None:
    """Written by the launcher, before it execs into the CLI, so a dashboard can
    see a session starting immediately and detect a stale 'running' status left
    by a process that died without updating it. Preserves history across runs —
    a project is typically launched many times over its life."""
    path = status_path(project)
    path.parent.mkdir(parents=True, exist_ok=True)
    history = []
    if path.is_file():
        try:
            prior = json.loads(path.read_text()).get("history")
            if isinstance(prior, list):
                history = prior[-MAX_STATUS_HISTORY:]
        except (json.JSONDecodeError, OSError):
            pass
    data = {
        "pid": pid,
        "state": "running",
        "current": {"round": None, "role": "orchestrator", "summary": summary},
        "history": history,
    }
    path.write_text(json.dumps(data, indent=2) + "\n")


def is_pid_alive(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, just owned by someone else
    except OSError:
        return False
    return True


def read_status(project_path: str) -> dict | None:
    path = Path(project_path) / LOCAL / "status.json"
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None
    if not isinstance(data, dict):
        return None
    data["_mtime"] = mtime_iso(path)
    return data


def gather_statuses() -> list[dict]:
    """One row per registered project. A project whose status file says 'running'
    but whose pid is no longer alive is reported as 'stale', not 'running' — this
    is what catches a session that died without reporting back."""
    rows = []
    for entry in load_registry():
        status = read_status(entry.get("path", ""))
        row = {"path": entry.get("path"), "name": entry.get("name") or Path(entry.get("path", "?")).name}
        if status is None:
            row.update(state="unknown", current=None, history=[], updated_at=None)
        else:
            state = status.get("state") if status.get("state") in STATUS_STATES else "unknown"
            if state == "running" and not is_pid_alive(status.get("pid")):
                state = "stale"
            row.update(
                state=state,
                current=status.get("current"),
                history=status.get("history") if isinstance(status.get("history"), list) else [],
                updated_at=status.get("_mtime"),
            )
        rows.append(row)
    return rows


def render_dashboard(rows: list[dict]) -> str:
    lines = [f"syndicate dashboard  ({now_iso()})", ""]
    if not rows:
        lines.append("no registered projects — run 'syndicate init' (or any run) in a project first")
        return "\n".join(lines)
    name_w = max(len(r["name"]) for r in rows)
    for r in rows:
        cur = r.get("current") or {}
        role = cur.get("role") or ""
        if isinstance(role, list):
            role = ", ".join(role)
        summary = cur.get("summary") or ("(no status reported yet)" if r["state"] == "unknown" else "")
        lines.append(f"[{r['state']:<14}] {r['name']:<{name_w}}  {role:<28} {summary}")
    return "\n".join(lines)


def cmd_dashboard(args: argparse.Namespace) -> int:
    try:
        while True:
            rows = gather_statuses()
            if not args.once:
                print("\x1b[2J\x1b[H", end="")  # clear screen, home cursor
            print(render_dashboard(rows))
            print("\n" + runtime.describe_limits())
            if args.once:
                return 0
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0


class _DashboardHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *a):  # keep stdout quiet
        pass

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._serve_file(WEB_DIR / "dashboard.html", "text/html; charset=utf-8")
        elif self.path == "/api/limits":
            body = json.dumps({"summary": runtime.describe_limits(),
                               "monitor": runtime.read_json(runtime.STATE / "monitor.json")}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/status":
            body = json.dumps(gather_statuses()).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()

    def _serve_file(self, path: Path, content_type: str) -> None:
        if not path.is_file():
            self.send_response(404)
            self.end_headers()
            return
        body = path.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def cmd_web(args: argparse.Namespace) -> int:
    server = http.server.HTTPServer(("127.0.0.1", args.port), _DashboardHandler)
    print(f"syndicate web dashboard: http://127.0.0.1:{server.server_address[1]}/  (ctrl-c to stop)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    # A project lock covers the entire confirmation/switch cycle, preventing
    # another orchestrator from racing snapshots or changing the worktree.
    import fcntl
    project = Path(args.dir).resolve()
    (project / LOCAL).mkdir(parents=True, exist_ok=True)
    with (project / LOCAL / "session.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SyndicateError("another Syndicate orchestrator already owns this project")
        while True:
            result = run_session(args)
            if result is not None:
                return result


def run_session(args: argparse.Namespace) -> int | None:
    project = Path(args.dir).resolve()
    team = resolve_team(project, args.runtime)
    if getattr(args, "all_runtime", None):
        for role in team.roles.values():
            role.cli = args.all_runtime
        team.roles["orchestrator"].cli = team.host
    reserve = getattr(args, "reserve", None)
    reserve = float(team.config["handoff-reserve"]) if reserve is None else reserve
    if not 0 < reserve < 100:
        raise SyndicateError("reserve must be between 0 and 100 (exclusive)")
    if getattr(args, "handoff_path", None):
        path = Path(args.handoff_path).resolve()
        if not (path / "handoff.md").is_file():
            raise SyndicateError(f"no handoff.md in {path}")
        args.rest = [f"Continue the interrupted work from {path / 'handoff.md'}. Read its checkpoint and status, verify the live worktree, then complete outstanding work, testing, and review."]
    for w in team.warnings:
        print(f"syndicate: {w}", file=sys.stderr)
    require_clis({r.cli for r in team.roles.values()})
    note = ensure_excluded(project)
    if note:
        print(f"syndicate: {note}", file=sys.stderr)
    build = build_claude if team.host == "claude" else build_codex
    argv = build(team, args.print, args.rest)
    if team.host == "claude" and args.print:
        # Headless Claude gives up on still-running subagents after 600s; a team run is longer.
        os.environ.setdefault("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS", "0")
    register_project(project)
    write_status_stub(project, os.getpid(), args.rest[0][:140] if args.rest else "(interactive session)")
    if team.config["handoff"] == "off":
        os.chdir(project)
        os.execvp(argv[0], argv)
    runtime.start_monitor(SCRIPT)
    providers = {r.cli for r in team.roles.values()}
    task = args.rest[0] if args.rest else "Interactive session; see checkpoint and session output for requests."
    print(f"syndicate: monitoring account limits; handoff at {reserve:g}% remaining. "
          "Unavailable telemetry pauses work after 60s.", file=sys.stderr)
    result, handoff = runtime.supervise(argv, project, providers, reserve, task, team.host, headless=args.print)
    if handoff is None:
        return result
    print(f"\nHandoff: {handoff}")
    target = runtime.choose_target(team.host, not args.print and sys.stdin.isatty())
    if target is None:
        return 75  # resumable temporary interruption; not successful completion
    require_clis({target})
    state, remaining = runtime.availability(runtime.read_json(runtime.STATE / f"{target}.json"))
    if remaining is not None and remaining <= reserve:
        print(f"syndicate: {target} also has only {remaining:g}% remaining; leaving work stopped.", file=sys.stderr)
        return 75
    args.runtime = target
    args.all_runtime = target
    args.handoff_path = str(handoff)
    return None  # cmd_run retains the project lock while starting the confirmed target


def cmd_run_role(args: argparse.Namespace) -> int:
    project = Path(args.dir).resolve()
    team = resolve_team(project)
    role = team.roles.get(args.role)
    if not role or args.role == "orchestrator":
        raise SyndicateError(f"unknown role '{args.role}'")
    if getattr(args, "runtime", None):
        role.cli = args.runtime
    require_clis({role.cli})
    brief = sys.stdin.read() if args.brief == "-" else args.brief
    if role.cli == "claude":
        argv = ["claude", "-p", "--agents", json.dumps({role.name: claude_agent(role)}), "--agent", role.name]
        if role.can_write:
            argv += ["--permission-mode", "acceptEdits"]
        argv.append(brief)
    else:
        argv = ["codex", "exec", "-C", str(project), "-s", role.sandbox,
                "-c", f"developer_instructions={jstr(role.body)}", brief]
    return subprocess.run(argv, cwd=project, stdin=subprocess.DEVNULL).returncode


def cmd_limits(args: argparse.Namespace) -> int:
    if args.stop:
        runtime.STATE.mkdir(parents=True, exist_ok=True)
        (runtime.STATE / "stop").touch()
        print("Limit monitor stop requested; agent sessions are unaffected.")
        return 0
    runtime.start_monitor(SCRIPT)
    offset = 0
    try:
        while True:
            print(runtime.describe_limits())
            notices = runtime.STATE / "notifications.log"
            if notices.exists():
                with notices.open() as f:
                    f.seek(offset)
                    print(f.read(), end="")
                    offset = f.tell()
            if not args.watch:
                return 0
            time.sleep(5)
    except KeyboardInterrupt:
        return 0


def cmd_init(args: argparse.Namespace) -> int:
    project = Path(args.dir).resolve()
    register_project(project)
    local = project / LOCAL
    (local / "roles").mkdir(parents=True, exist_ok=True)
    config = local / "config"
    if config.exists():
        print(f"kept existing {config}")
    else:
        config.write_text(CONFIG_TEMPLATE)
        print(f"created {config}")
    print(f"created {local / 'roles'}/ (drop role overrides here; see docs/configuration.md)")
    note = ensure_excluded(project)
    print(note or f"{LOCAL}/ is excluded from git via .git/info/exclude")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    project = Path(args.dir).resolve()
    team = resolve_team(project)
    print(f"project: {project}")
    print(f"host (orchestrator): {team.host}    review gate: {'on' if team.gate else 'off'}\n")
    width = max(len(n) for n in team.roles)
    for name, role in team.roles.items():
        print(f"  {name:<{width}}  {role.cli:<7} {' + '.join(role.sources)}")
    for w in team.warnings:
        print(f"\nwarning: {w}")
    return 0


def cmd_setup_codex_gate(args: argparse.Namespace) -> int:
    path = Path.home() / ".codex" / "hooks.json"
    data = json.loads(path.read_text()) if path.is_file() else {}
    command = shlex.quote(str(GATE_SCRIPT))
    stop = [e for e in data.get("hooks", {}).get("Stop", [])
            if not any(h.get("command") == command for h in e.get("hooks", []))]
    if not args.remove:
        stop.append({"hooks": [{"type": "command", "command": command}]})
    hooks = data.setdefault("hooks", {})
    if stop:
        hooks["Stop"] = stop
    else:
        hooks.pop("Stop", None)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    if args.remove:
        print(f"removed the review-gate hook from {path}")
    else:
        print(f"installed the review-gate hook in {path}")
        print("Codex runs it only after you approve it once: open 'codex' and accept the hook review prompt.")
    return 0


def build_parsers() -> tuple[argparse.ArgumentParser, argparse.ArgumentParser]:
    run = argparse.ArgumentParser(
        prog="syndicate",
        usage="syndicate [-x claude|codex] [-C dir] [-p] [task] [extra CLI args...]",
        description="Run the orchestrator with the project's team. Other commands: "
                    "init, status, run-role, setup-codex-gate, dashboard, web, limits.",
    )
    run.add_argument("-x", "--runtime", choices=CLIS, help="CLI hosting the orchestrator (overrides project config)")
    run.add_argument("-C", "--dir", default=".", help="project directory (default: current)")
    run.add_argument("-p", "--print", action="store_true", help="run headless and print the result")
    run.add_argument("--reserve", type=float, help="handoff when this percentage of account usage remains (default: 10)")
    run.add_argument("--handoff", dest="handoff_path", help="continue from a saved handoff directory")
    run.add_argument("--all-runtime", choices=CLIS, help="use this CLI for every specialist in this run (combine with -x)")
    run.add_argument("rest", nargs=argparse.REMAINDER, help="the task, then any extra args for the CLI")

    sub = argparse.ArgumentParser(prog="syndicate")
    cmds = sub.add_subparsers(dest="cmd", required=True)
    for name, fn, text in (
        ("init", cmd_init, "create .syndicate/ in a project and exclude it from git"),
        ("status", cmd_status, "show the resolved team: each role's CLI and where its definition comes from"),
    ):
        p = cmds.add_parser(name, help=text)
        p.add_argument("-C", "--dir", default=".")
        p.set_defaults(fn=fn)
    p = cmds.add_parser("run-role", help="run one role headlessly on its configured CLI (used by relay agents)")
    p.add_argument("role")
    p.add_argument("--runtime", choices=CLIS, help="use the runtime resolved by the parent session")
    p.add_argument("brief", help="the task, or - to read it from stdin")
    p.add_argument("-C", "--dir", default=".")
    p.set_defaults(fn=cmd_run_role)
    p = cmds.add_parser("setup-codex-gate", help="install the review-gate hook into ~/.codex/hooks.json (once)")
    p.add_argument("--remove", action="store_true")
    p.set_defaults(fn=cmd_setup_codex_gate)
    p = cmds.add_parser("dashboard", help="live console view of every registered project's status")
    p.add_argument("--interval", type=float, default=2.0, help="seconds between refreshes (default: 2)")
    p.add_argument("--once", action="store_true", help="render once and exit (for scripting)")
    p.set_defaults(fn=cmd_dashboard)
    p = cmds.add_parser("web", help="local browser dashboard (http://127.0.0.1:<port>/)")
    p.add_argument("--port", type=int, default=8765)
    p.set_defaults(fn=cmd_web)
    p = cmds.add_parser("limits", help="show account limits and reset notifications; starts the background monitor")
    p.add_argument("--watch", action="store_true", help="keep displaying limits and reset notices")
    p.add_argument("--stop", action="store_true", help="stop the background monitor")
    p.set_defaults(fn=cmd_limits)
    return run, sub


def main(argv: list[str]) -> int:
    if argv == ["_claude-usage"]:
        try:
            observation = runtime.save_observation("claude", json.load(sys.stdin))
            state, remaining = runtime.availability(observation)
            print(f"Syndicate: Claude {remaining:g}% account usage remaining" if remaining is not None else f"Syndicate: Claude usage {state}")
            return 0
        except (OSError, ValueError, TypeError, AttributeError):
            print("Syndicate: Claude usage unknown")
            return 0
    if argv == ["_limits-monitor"]:
        return runtime.monitor_forever()
    run, sub = build_parsers()
    try:
        if argv and argv[0] in ("init", "status", "run-role", "setup-codex-gate", "dashboard", "web", "limits"):
            args = sub.parse_args(argv)
            return args.fn(args)
        args = run.parse_args(argv)
        args.fn = cmd_run
        return cmd_run(args)
    except SyndicateError as e:
        print(f"syndicate: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
