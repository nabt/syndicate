import shlex
import shutil
import subprocess
import sys
import time
import tempfile
import signal
import stat
import tomllib
import uuid
from contextlib import ExitStack, contextmanager
from copy import copy
from datetime import datetime, timezone
from pathlib import Path

SCRIPT = Path(__file__).resolve()
sys.path.insert(0, str(SCRIPT.parent))
import syndicate_runtime as runtime
import syndicate_portfolio as portfolio
import syndicate_live as live
import syndicate_git
import syndicate_worktrees
HOME_DIR = SCRIPT.parent.parent
GLOBAL_ROLES = HOME_DIR / "roles"
GATE_SCRIPT = HOME_DIR / "hooks" / "require-review.sh"
WEB_DIR = HOME_DIR / "web"
HANDOFF_SKILL = HOME_DIR / "skills" / "syndicate-handoff" / "SKILL.md"
CHIEF_ROLE = HOME_DIR / "portfolio" / "chief-of-staff.md"
PROJECT_SKILL = HOME_DIR / "skills" / "syndicate-project" / "SKILL.md"
CLOSEOUT_SKILL = HOME_DIR / 'skills' / 'syndicate-closeout' / 'SKILL.md'
INBOX_SKILL = HOME_DIR / 'skills' / 'syndicate-inbox' / 'SKILL.md'
SCHEDULER_TOOLS = ['CronCreate', 'CronList', 'CronDelete']
REGISTRY_PATH = Path.home() / ".syndicate" / "projects.json"
# One shared session. Chief of Staff and each team are windows in it, not sessions of their own.
TMUX_SESSION = 'the-syndicate'
CHIEF_TMUX_WINDOW = 'chief-of-staff'
# Temporary window that shows several workers at once. It is not itself a worker.
VIEW_WINDOW = 'syndicate-view'
# Ignore a just-opened view long enough for the client to land on it.
VIEW_HOLD_SECONDS = 3
CLIS = runtime.PROVIDERS
LOCAL = ".syndicate"
ROLE_NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")
RELAY_SANDBOX = "workspace-write"
STATUS_STATES = ("running", "waiting_on_user", "on_hold", "done", "ended")
MAX_STATUS_HISTORY = 200
# Closed without completion: the owning session ended while the task still
# claimed to be in progress. Distinct from done, which asserts completion.
ENDED = "ended"
DONE_STATES = ("done", "completed")
LOCK_ATTEMPTS = 20  # x 50ms: tolerate momentary shared probes of session.lock

CONFIG_DEFAULTS = {
    "codex-tui.show_tooltips": "false",
    "tmux": "on",
    "default": "claude",
    "handoff": "on",
    "handoff-reserve": "10",
    "review-gate": "on",
    'inbox-interval': '5',
    'inbox-transport': 'auto',
}

CONFIG_TEMPLATE = """\
# Local-only syndicate team config for this project (git-ignored).
# One 'key = value' per line; '#' starts a comment.
# A key set here replaces the same key from the user file
# ($XDG_CONFIG_HOME/syndicate/syndicate.conf, or ~/.config/syndicate/syndicate.conf).
# Keys absent from both files keep their built-in defaults. This file is not
# rewritten from the user file.
# Global-only: set 'tmux = off' in the user file to disable tmux for all CLI execution.
#
# default = claude        # CLI for every role not listed below: claude | codex
# orchestrator = claude   # CLI that hosts the session; other roles are delegated to from it
# code-reviewer = codex   # any role name: a global role or one defined in .syndicate/roles/
# handoff = on            # monitor quotas and checkpoint before switching providers
# handoff-reserve = 10    # percentage of account usage remaining at which to stop
# review-gate = on        # on (default) | off: block finishing until code-reviewer has reviewed
# inbox-interval = 5      # polling interval in minutes; must divide 60 evenly
# inbox-transport = auto  # auto: Codex queue / Claude scheduled poll; poll | channel
# codex-model_verbosity = low  # Codex --config model_verbosity='"low"'
# codex-tui.show_tooltips = false  # default: hide Codex onboarding tips
# claude-model = sonnet   # Claude --model sonnet
# claude-verbose = false  # true passes --verbose; false omits it
"""


class SyndicateError(Exception):
    pass


class SpecialistReserveReached(runtime.RoleUsageLimit, SyndicateError):
    pass


def jstr(text: str) -> str:
    """JSON string literal, which is also a valid TOML basic string."""
    return json.dumps(text, ensure_ascii=False).replace("\x7f", "\\u007f")


def split_frontmatter(text: str) -> tuple[dict, str]:
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        return {}, text
    fm = {}
    for line in m.group(1).splitlines():
        key, sep, value = line.partition(":")
        if sep and not line.startswith((" ", "#")):
            fm[key.strip()] = value.strip()
    return fm, m.group(2)


class Role:
    def __init__(self, name: str, fm: dict, body: str, sources: list[str]):
        self.name = name
        self.description = fm.get("description") or f"The {name} role."
        tools = fm.get("tools")
        self.tools = [t.strip() for t in tools.split(",") if t.strip()] if tools else None
        self.body = body.strip()
        self.sources = sources
        self.cli = "claude"

    @property
    def can_write(self) -> bool:
        return self.tools is None or bool({"Write", "Edit"} & set(self.tools))

    @property
    def sandbox(self) -> str:
        return "workspace-write" if self.can_write else "read-only"


class ConfigLayer:
    def __init__(self, source: str, label: str, values: dict[str, str], path: Path | None = None):
        self.source = source
        self.label = label
        self.values = values
        self.path = path


class Team:
    def __init__(self, project: Path, roles: dict[str, Role], config: dict, config_sources: dict,
                 layers: list[ConfigLayer], warnings: list[str], host: str):
        self.project = project
        self.roles = roles
        self.config = config
        self.config_sources = config_sources
        self.layers = layers
        self.warnings = warnings
        self.host = host

    @property
    def gate(self) -> bool:
        return self.config["review-gate"] == "on"


def load_roles(project: Path) -> tuple[dict[str, Role], list[str]]:
    parsed: dict[str, dict] = {}
    warnings: list[str] = []
    for f in sorted(GLOBAL_ROLES.glob("*.md")):
        fm, body = split_frontmatter(f.read_text())
        parsed[f.stem] = {"fm": fm, "body": body, "sources": ["global"]}

    local = project / LOCAL / "roles"
    if local.is_dir():
        for f in sorted(local.glob("*.md")):
            if f.name.endswith(".append.md"):
                continue
            if not ROLE_NAME.match(f.stem):
                warnings.append(f"ignoring {f}: role names are lowercase letters, digits and dashes")
                continue
            fm, body = split_frontmatter(f.read_text())
            base = parsed.get(f.stem)
            merged = dict(base["fm"]) if base else {}
            merged.update(fm)
            parsed[f.stem] = {"fm": merged, "body": body, "sources": ["project override" if base else "project"]}
        for f in sorted(local.glob("*.append.md")):
            name = f.name[: -len(".append.md")]
            if name not in parsed:
                warnings.append(f"ignoring {f}: no role named '{name}' to append to")
                continue
            _, extra = split_frontmatter(f.read_text())
            parsed[name]["body"] = parsed[name]["body"].rstrip() + "\n\n## Project-Specific Guidance\n\n" + extra.strip()
            parsed[name]["sources"].append("appended")

    roles = {n: Role(n, p["fm"], p["body"], p["sources"]) for n, p in parsed.items()}
    return roles, warnings


def user_config_path() -> Path:
    """User-wide settings. $XDG_CONFIG_HOME wins when it is set and non-empty."""
    base = os.environ.get("XDG_CONFIG_HOME", "").strip()
    root = Path(base).expanduser() if base else Path.home() / ".config"
    return root / "syndicate" / "syndicate.conf"


def project_config_path(project: Path) -> Path:
    """Project settings. A leftover `.syndicate/config` is renamed once."""
    path = project / LOCAL / "syndicate.conf"
    legacy = project / LOCAL / "config"
    if not path.exists() and legacy.is_file():
        legacy.rename(path)
    return path


def config_entries(path):
    """Keep quoted # characters and strip only comments outside strings."""
    for n, raw in enumerate(path.read_text().splitlines(), 1):
        quote, escaped = None, False
        end = len(raw)
        for i, char in enumerate(raw):
            if escaped:
                escaped = False
            elif quote == '"' and char == '\\':
                escaped = True
            elif quote:
                if char == quote:
                    quote = None
            elif char in ('"', "'"):
                quote = char
            elif char == '#':
                end = i
                break
        line = raw[:end].strip()
        if not line:
            continue
        key, sep, value = (p.strip() for p in line.partition("="))
        where = f"{path}:{n}"
        if not sep or not key or not value:
            raise SyndicateError(f"{where}: expected 'key = value'")
        yield key, value, where


def cli_setting(key):
    return next((cli for cli in CLIS if key.startswith(cli + '-')), None)


def cli_value(value):
    try:
        return tomllib.loads('value = ' + value)['value']
    except tomllib.TOMLDecodeError:
        return value


def validate_cli_setting(key, value, where):
    cli = cli_setting(key)
    option = key[len(cli) + 1:]
    if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_.-]*', option):
        raise SyndicateError(f'{where}: invalid {cli} option name')
    if cli == 'claude' and not isinstance(cli_value(value), (str, bool, int, float)):
        raise SyndicateError(f'{where}: Claude options require a scalar value')


def cli_options(provider, config=None):
    if config is None:
        # Chief uses user-wide CLI settings, independent of project roles.
        config = dict(CONFIG_DEFAULTS)
        path = user_config_path()
        if path.is_file():
            for key, value, where in config_entries(path):
                if cli_setting(key):
                    validate_cli_setting(key, value, where)
                    config[key] = value
    argv = []
    for key, value in config.items():
        if cli_setting(key) != provider:
            continue
        option = key[len(provider) + 1:]
        decoded = cli_value(value)
        if provider == 'codex':
            # Bare strings need TOML quotes; typed TOML values retain their syntax.
            encoded = jstr(decoded) if isinstance(decoded, str) else value
            argv += ['--config', f'{option}={encoded}']
        elif decoded is True:
            argv.append('--' + option)
        elif decoded is not False:
            argv += ['--' + option, str(decoded)]
    return argv


def parse_config_file(path: Path, roles: dict[str, Role]) -> dict[str, str]:
    parsed: dict[str, str] = {}
    for key, value, where in config_entries(path):
        if key == "handoff-reserve":
            try:
                valid = 0 < float(value) < 100
            except ValueError:
                valid = False
            if not valid:
                raise SyndicateError(f"{where}: handoff-reserve must be between 0 and 100 (exclusive)")
        elif key == 'inbox-interval':
            try:
                live.interval_minutes(value)
            except portfolio.PortfolioError as error:
                raise SyndicateError(f'{where}: {error}') from error
        elif key == 'inbox-transport':
            if value not in ('auto', 'poll', 'channel'):
                raise SyndicateError(f'{where}: inbox-transport must be auto, poll, or channel')
        elif key in ("review-gate", "handoff", "tmux"):
            if value not in ("on", "off"):
                raise SyndicateError(f"{where}: {key} must be on or off")
        elif cli_setting(key):
            validate_cli_setting(key, value, where)
        elif key == "default" or key in roles:
            if value not in CLIS:
                raise SyndicateError(f"{where}: cli must be one of {', '.join(CLIS)}")
        else:
            raise SyndicateError(f"{where}: unknown role '{key}' (known: {', '.join(sorted(roles))})")
        if key == "tmux" and path != user_config_path():
            raise SyndicateError(f"{where}: tmux is a global-only setting")
        parsed[key] = value
    return parsed


def load_config(project: Path, roles: dict[str, Role]) -> tuple[dict[str, str], dict[str, str], list[ConfigLayer]]:
    """Merge built-in defaults, $SYNDICATE_RUNTIME, the user file, then the project file.

    A later layer replaces one key and leaves every other key in place. The project
    layer is always present so a missing project file can still be shown.
    """
    layers = [ConfigLayer("default", "built-in defaults", dict(CONFIG_DEFAULTS))]
    env = os.environ.get("SYNDICATE_RUNTIME")
    if env:
        if env not in CLIS:
            raise SyndicateError(f"SYNDICATE_RUNTIME must be one of {', '.join(CLIS)}")
        layers.append(ConfigLayer("environment", "$SYNDICATE_RUNTIME", {"default": env}))
    user = user_config_path()
    if user.is_file():
        layers.append(ConfigLayer("user", str(user), parse_config_file(user, roles), user))
    project_path = project_config_path(project)
    project_values = parse_config_file(project_path, roles) if project_path.is_file() else {}
    layers.append(ConfigLayer("project", str(project_path), project_values, project_path))
    config: dict[str, str] = {}
    sources: dict[str, str] = {}
    for layer in layers:
        for key, value in layer.values.items():
            config[key] = value
            sources[key] = layer.source
    return config, sources, layers


def configured_cli(team: Team, role_name: str) -> str | None:
    """The CLI a person named for this launch, or None for the built-in fallback.

    A role key or `orchestrator` counts when it comes from the user or project
    file. `default` counts from those files or from `$SYNDICATE_RUNTIME`. The
    built-in `default = claude` is not a choice.
    """
    if role_name == "orchestrator" and team.config_sources.get("orchestrator") in ("user", "project"):
        return team.config["orchestrator"]
    if role_name != "orchestrator" and team.config_sources.get(role_name) in ("user", "project"):
        return team.config[role_name]
    if team.config_sources.get("default") in ("user", "project", "environment"):
        return team.config["default"]
    return None


def configured_default_cli() -> str | None:
    """The user-file or `$SYNDICATE_RUNTIME` default, ignoring the built-in."""
    chosen = os.environ.get("SYNDICATE_RUNTIME")
    chosen = chosen if chosen in CLIS else None
    path = user_config_path()
    if path.is_file():
        for key, value, _where in config_entries(path):
            if key == "default" and value in CLIS:
                chosen = value
    return chosen


def select_launch_cli(preferred: str | None, threshold: float, candidates: list[str], cwd=None) -> str | None:
    """Refresh the readings this choice needs and return the CLI to start.

    A configured CLI that is already current and above `threshold` is used
    without querying the other engine. A recorded reading that is not current
    is queried when the choice depends on it. A CLI with no recorded reading
    is not queried here. None means no candidate is known to be above the
    threshold.
    """
    candidates = [cli for cli in candidates if cli in CLIS and shutil.which(cli)]
    if preferred not in candidates:
        preferred = None
    readings = {cli: runtime.recorded_remaining(cli, threshold) for cli in candidates}

    def observation(cli):
        return runtime.read_json(runtime.STATE / f"{cli}.json")

    def current(cli):
        return readings[cli] is not None and runtime.availability(observation(cli))[0] == "current"

    def pull(cli):
        # Nothing recorded is not a stale reading. Querying it would spend a
        # turn before any session has published usage.
        if readings[cli] is None or current(cli):
            return
        readings[cli], _refreshed = runtime.ensure_reading(cli, cwd=cwd, threshold=threshold)

    def ranks():
        return {cli: runtime.readings_by_kind(observation(cli)) for cli in candidates}

    if preferred and current(preferred) and readings[preferred] > threshold:
        return preferred
    if preferred:
        pull(preferred)
        if readings.get(preferred) is not None and readings[preferred] > threshold:
            return preferred
    for cli in candidates:
        if cli != preferred:
            pull(cli)
    return runtime.choose_engine(preferred, readings, threshold, candidates, ranks())


def announce_cli_switch(preferred: str | None, chosen: str, threshold: float) -> None:
    remaining = runtime.recorded_remaining(chosen)
    detail = f"{remaining:g}% remaining" if remaining is not None else "the latest reading"
    if preferred:
        print(f"syndicate: {preferred} is not above the {threshold:g}% reserve; "
              f"starting on {chosen} ({detail}).", file=sys.stderr)
    else:
        print(f"syndicate: no CLI is configured; starting on {chosen} ({detail}).", file=sys.stderr)


def resolve_team(project: Path, host_override: str | None = None) -> Team:
    roles, warnings = load_roles(project)
    if "orchestrator" not in roles:
        raise SyndicateError("no 'orchestrator' role found")
    config, sources, layers = load_config(project, roles)
    for name, role in roles.items():
        role.cli = config.get(name, config["default"])
    host = host_override or roles["orchestrator"].cli
    if host not in CLIS:
        raise SyndicateError(f"unknown runtime '{host}' (use {' or '.join(CLIS)})")
    roles["orchestrator"].cli = host
    return Team(project, roles, config, sources, layers, warnings, host)


def render_config(team: Team, local: bool) -> str:
    """Resultant settings grouped by the layer that won, or the full stack with --local.

    --local keeps keys a later layer replaced and marks the project file with *.
    """
    lines = [f"project: {team.project}"]
    winners = {layer.source: layer for layer in team.layers}
    for layer in team.layers:
        rows = []
        for key, value in layer.values.items():
            winning = winners[team.config_sources[key]]
            if local:
                note = "" if winning is layer else f"  # overridden by {winning.label}"
                rows.append(f"{key} = {value}{note}")
            elif winning is layer:
                rows.append(f"{key} = {value}")
        show_project = local and layer.source == "project"
        if not rows and not show_project:
            continue
        star = "* " if show_project else ""
        lines.append("")
        lines.append(f"# {star}{layer.label}")
        if show_project and layer.path is not None and not layer.path.is_file():
            lines.append("# absent")
        lines.extend(rows)
    for warning in team.warnings:
        lines.append(f"warning: {warning}")
    return "\n".join(lines) + "\n"


def render_global_config() -> str:
    """The user-wide syndicate.conf only, comments included."""
    path = user_config_path()
    if not path.is_file():
        return f"# {path}\n# absent\n"
    text = path.read_text()
    if text and not text.endswith("\n"):
        text += "\n"
    return f"# {path}\n{text}"


def latest_status_project() -> Path:
    """Registered project whose .syndicate/status.json was written most recently."""
    best: Path | None = None
    best_mtime = -1.0
    for entry in load_registry():
        raw = entry.get("path")
        if not raw:
            continue
        path = Path(raw)
        try:
            mtime = (path / LOCAL / "status.json").stat().st_mtime
        except OSError:
            continue
        if mtime > best_mtime:
            best_mtime = mtime
            best = path
    if best is None:
        raise SyndicateError("no registered project has a status file; pass -C <project>")
    return best


def git(project: Path, *args: str) -> str | None:
    r = subprocess.run(["git", "-C", str(project), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def ensure_excluded(project: Path) -> str | None:
    """Keep .syndicate/ out of git via the repo's local-only exclude file (never .gitignore)."""
    top = git(project, "rev-parse", "--show-toplevel")
    exclude = git(project, "rev-parse", "--git-path", "info/exclude")
    if not top or not exclude:
        return "not a git repository: nothing to exclude"
    exclude_path = Path(exclude) if os.path.isabs(exclude) else project / exclude
    rel = project.resolve().relative_to(Path(top).resolve()).as_posix()
    pattern = "/" + ("" if rel == "." else rel + "/") + LOCAL + "/"
    text = exclude_path.read_text() if exclude_path.exists() else ""
    if pattern not in text.splitlines():
        exclude_path.parent.mkdir(parents=True, exist_ok=True)
        with exclude_path.open("a") as f:
            if text and not text.endswith("\n"):
                f.write("\n")
            f.write(f"# syndicate: local-only team config and generated agents\n{pattern}\n")
    if git(project, "ls-files", LOCAL):
        return f"warning: {LOCAL}/ has tracked files; run 'git rm -r --cached {LOCAL}' to keep it local-only"
    return None


def generated(project: Path) -> Path:
    path = project / LOCAL / ".generated"
    path.mkdir(parents=True, exist_ok=True)
    return path


def relay_command(role: Role, project: Path, *, pin: bool = False) -> str:
    pinned = f" --runtime {role.cli}" if pin else ""
    return (f"{shlex.quote(str(SCRIPT))} team run-role {role.name} --project {shlex.quote(str(project))}"
            f"{pinned} -")


def relay_prompt(role: Role, project: Path, *, pin: bool = False) -> str:
    return f"""\
You are a relay for the `{role.name}` role, which is configured for the {role.cli} CLI in this project. You do not do the work yourself. `run-role` keeps that CLI when it has usage above the reserve, and otherwise starts the CLI with the most usage left, compared monthly, then weekly, then the 5-hour window.

1. Write a complete, self-contained brief for the role from the task you were given. The role cannot see this conversation, so include the goal, constraints, relevant file paths, and what to return.
2. Run exactly this command with Bash, putting the brief in the heredoc:

{relay_command(role, project, pin=pin)} <<'SYNDICATE_BRIEF'
<the brief>
SYNDICATE_BRIEF

3. If the sandbox denies scratch creation, the specialist lease write, task hold ownership validation, or the child CLI's network connection, request normal approval to run this exact command outside the sandbox. Explain the denied operation; do not broaden the relay sandbox or change the command. If approval is unavailable, report the failure to the orchestrator so it can request approval.
4. Reply with the command's output verbatim as your final answer, including the specialist completion ID on success. For failures, include the exit status and error. Do not retry a different way or do the work yourself.
"""


def orchestrator_body(team: Team) -> str:
    body = team.roles["orchestrator"].body + "\n\n" + split_frontmatter(PROJECT_SKILL.read_text())[1]
    if team.config["handoff"] == "on":
        body += "\n\n" + split_frontmatter(HANDOFF_SKILL.read_text())[1]
    role_retry = shlex.join([sys.executable, str(SCRIPT), "team", "run-role"])
    body += (
        "\n\n## Specialist usage limits\n"
        "Syndicate retries relayed specialists automatically on account usage-limit failures. "
        "If the provider reports an account usage-limit failure for a native specialist, retry "
        f"through `{role_retry} ROLE --project {shlex.quote(str(team.project))} "
        "--backoff-from PROVIDER -` with the brief on stdin. Use the failed role's name and actual "
        "provider. Ask for the usual approval if the shell sandbox denies the specialist command. "
        "Include any known partial work so the next specialist can continue it. A role's ordinary "
        "failure or discussion of usage limits is not a provider quota failure. When Syndicate "
        "reports the task is on hold, its closeout is already committed. Preserve outstanding "
        "work in the checkpoint before ending the session."
    )
    body += "\n\n" + split_frontmatter(CLOSEOUT_SKILL.read_text())[1]
    return body + live_instructions(team.project)


def claude_agent(role: Role) -> dict:
    agent = {"description": role.description, "prompt": role.body}
    if role.tools:
        agent["tools"] = role.tools
    return agent


def build_claude(team: Team, headless: bool, rest: list[str]) -> list[str]:
    agents, relays = {}, False
    for name, role in team.roles.items():
        if name == "orchestrator" or role.cli == "claude":
            agents[name] = claude_agent(role)
            if name == "orchestrator":
                agents[name]["prompt"] = orchestrator_body(team)
                if not headless and agents[name].get('tools'):
                    agents[name]['tools'] = agents[name]['tools'] + [t for t in SCHEDULER_TOOLS if t not in agents[name]['tools']]
        else:
            relays = True
            agents[name] = {
                "description": role.description,
                "prompt": relay_prompt(role, team.project, pin=getattr(team, "pin_runtimes", False)),
                "tools": ["Bash"],
            }
    settings: dict = {}
    if team.config["handoff"] == "on":
        settings["statusLine"] = {"type": "command", "command":
            shlex.join([sys.executable, str(SCRIPT), "_claude-usage"])}
    if team.gate:
        settings["hooks"] = {"Stop": [{"hooks": [{"type": "command", "command": shlex.quote(str(GATE_SCRIPT))}]}]}
    if relays:
        settings["permissions"] = {"allow": [f"Bash({SCRIPT} team run-role *)"]}
    argv = ["claude", "--agent", "orchestrator", "--agents", json.dumps(agents)]
    if settings:
        path = generated(team.project) / "claude-settings.json"
        path.write_text(json.dumps(settings, indent=2) + "\n")
        argv += ["--settings", str(path)]
    if headless:
        argv.append("-p")
    return argv + cli_options('claude', team.config) + rest


def build_codex(team: Team, headless: bool, rest: list[str]) -> list[str]:
    (REGISTRY_PATH.parent / "portfolio").mkdir(parents=True, exist_ok=True, mode=0o700)
    gen = generated(team.project) / "codex"
    gen.mkdir(parents=True, exist_ok=True)
    keep: set[str] = set()
    overrides: list[str] = []
    relays = False
    for name, role in team.roles.items():
        if name == "orchestrator":
            continue
        relays = relays or role.cli != "codex"
        if role.cli == "codex" and role.can_write:
            instructions, sandbox = role.body, role.sandbox
        else:
            instructions = relay_prompt(role, team.project, pin=getattr(team, "pin_runtimes", False))
            sandbox = "read-only" if role.cli == "codex" and not role.can_write else RELAY_SANDBOX
        f = gen / f"{name}.toml"
        config = f"developer_instructions = {jstr(instructions)}\nsandbox_mode = {jstr(sandbox)}\n"
        if sandbox == "workspace-write":
            config += f"[sandbox_workspace_write]\nwritable_roots = [{jstr(str(REGISTRY_PATH.parent / 'portfolio'))}]\n"
        f.write_text(config)
        keep.add(f.name)
        overrides += [
            "-c", f"agents.{name}.description={jstr(role.description)}",
            "-c", f"agents.{name}.config_file={jstr(str(f))}",
        ]
    for old in gen.glob("*.toml"):
        if old.name not in keep:
            old.unlink()
    names = ", ".join(n for n in team.roles if n != "orchestrator")
    instructions = (
        orchestrator_body(team)
        + f"\n\nSpecialist roles are available as custom agents with these exact names; spawn them to delegate: {names}."
    )
    if relays:
        # Relay agents run another CLI, which must reach its API; the sandbox blocks network by default.
        overrides += ["-c", "sandbox_workspace_write.network_access=true"]
    argv = ["codex"]
    if headless:
        argv += ["exec", "-C", str(team.project), "-s", "workspace-write"]
    else:
        argv += ["-C", str(team.project), "-s", "workspace-write"]
    return argv + ["--add-dir", str(REGISTRY_PATH.parent / "portfolio"),
                   "-c", f"developer_instructions={jstr(instructions)}"] + overrides + cli_options('codex', team.config) + rest


def require_clis(clis: set[str]) -> None:
    for cli in sorted(clis):
        if not shutil.which(cli):
            raise SyndicateError(f"the '{cli}' CLI is not installed or not on PATH")


# --- status & registry (bin/syndicate instruments; roles/orchestrator.md is the other writer) ---

def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def mtime_iso(path: Path) -> str | None:
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except OSError:
        return None


def load_registry() -> list[dict]:
    if not REGISTRY_PATH.is_file():
        return []
    try:
        data = json.loads(REGISTRY_PATH.read_text())
    except (json.JSONDecodeError, OSError):
        return []
    return data.get("projects", []) if isinstance(data, dict) else []


@contextmanager
def registry_lock():
    import fcntl
    REGISTRY_PATH.parent.mkdir(parents=True, exist_ok=True)
    with REGISTRY_PATH.with_suffix(".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def register_project(project: Path, generic: bool = False) -> None:
    """Record this project in the user-wide registry so dashboard/web can find it
    without being pointed at it explicitly."""
    path_str = str(project)
    with registry_lock():
        projects = [p for p in load_registry() if p.get("path") != path_str]
        entry = {"path": path_str, "name": project.name, "last_seen": now_iso()}
        if generic:
            entry["group_path"] = str(REGISTRY_PATH.parent / "generic-tasks")
        projects.insert(0, entry)
        runtime.atomic_json(REGISTRY_PATH, {"projects": projects})


def resolve_project(value: str) -> Path:
    if value == "generic":
        return REGISTRY_PATH.parent / "generic-tasks"
    matches = [p for p in load_registry() if p.get("name") == value and not p.get("group_path")]
    if len(matches) > 1:
        raise SyndicateError("ambiguous project name; use its full repo path")
    candidate = Path(matches[0]["path"] if matches else value).expanduser().resolve()
    root = git(candidate, "rev-parse", "--show-toplevel")
    if not root:
        raise SyndicateError(f"not a Git repository: {value}")
    return Path(root).resolve()


def register_workspace(directory: Path) -> Path:
    root = git(directory, "rev-parse", "--show-toplevel")
    workspace = Path(root).resolve() if root else directory.resolve()
    register_project(workspace, generic=not root)
    return workspace


def status_path(project: Path) -> Path:
    return project / LOCAL / "status.json"


def write_status_stub(project: Path, pid: int, summary: str) -> None:
    """Written by the launcher, before it execs into the CLI, so a dashboard can
    see a session starting immediately and detect a stale 'running' status left
    by a process that died without updating it. Preserves history across runs —
    a project is typically launched many times over its life."""
    path = status_path(project)
    path.parent.mkdir(parents=True, exist_ok=True)
    history = []
    tasks = []
    if path.is_file():
        try:
            previous = read_status(str(project)) or {}
            tasks = project_tasks(previous)
            prior = previous.get("history")
            if isinstance(prior, list):
                history = prior[-MAX_STATUS_HISTORY:]
        except (json.JSONDecodeError, OSError):
            pass
    owner = owner_identity(pid)
    data = {
        **owner,
        "state": "running",
        "current": {"round": None, "role": "orchestrator", "summary": summary},
        "history": history,
        "tasks": tasks + [{"id": uuid.uuid4().hex, "summary": summary,
                           "state": "running", "updated_at": now_iso(), **owner}],
    }
    data["current"]["task_id"] = data["tasks"][-1]["id"]
    path.write_text(json.dumps(data, indent=2) + "\n")


def owner_identity(pid) -> dict:
    """PID plus reuse-proof start identity, and the PID namespace and machine it was read on."""
    return portfolio.owner_record(pid)


# Launcher-recorded ownership facts. Agents must preserve them like pid.
OWNER_FIELDS = ("process_identity", "process_namespace", "machine_id", "lock_owned", "lock_inode", "cli_owner")


def status_session_id(row: dict) -> str | None:
    token = row.get('session_id')
    return token if isinstance(token, str) and token else None


def read_status(project_path: str, *, current_closeouts: set | None = None) -> dict | None:
    path = Path(project_path) / LOCAL / "status.json"
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None
    if not isinstance(data, dict):
        return None
    current = data.get('current')
    tasks = data.get('tasks') if isinstance(data.get('tasks'), list) else []
    source = str(Path(project_path).resolve())
    closeout_states = ('done', 'completed', 'blocked')
    managed_sessions = None
    for task in tasks:
        if not isinstance(task, dict):
            continue
        task_id = task.get('id')
        is_current = isinstance(current, dict) and current.get('task_id') == task_id
        task_session = status_session_id(task)
        current_session = status_session_id(current) if is_current else None
        needs_recovery = is_current and (task_session is None) != (current_session is None)
        task_reports_closeout = task.get('state') in closeout_states
        current_reports_closeout = is_current and data.get('state') in closeout_states
        if not (task_reports_closeout or current_reports_closeout or needs_recovery):
            continue
        marked_managed = task.get('delegated_closeout_required') is True
        session_id = task_session or current_session
        if isinstance(task_id, str) and session_id and (not marked_managed or needs_recovery):
            # The launcher records this requirement outside the agent's status.
            # Sessions from before that record was introduced retain their behavior.
            if managed_sessions is None:
                managed_sessions = {
                    (session['task_id'], session['id']) for session in coordination_store().read()['sessions']
                    if session['source_path'] == source and session.get('delegated_closeout_required') is True
                }
            if (task_id, session_id) in managed_sessions:
                marked_managed = True
                if needs_recovery:
                    # Restore the malformed copy in the effective view only.
                    current['session_id'] = task['session_id'] = session_id
        if not marked_managed:
            continue
        if task_reports_closeout:
            task.update(state='running', completed_at=None)
        if current_reports_closeout:
            data['state'] = 'running'
            current['summary'] = 'This state requires closeout with the applicable specialist details.'
    # The notification and task patch share one authoritative atomic commit.
    # Apply at read time; never overwrite concurrent agent-owned status writes.
    for record in live.MessageStore(portfolio_dir()).read():
        patch = record.get('closeout')
        if record['source_path'] != source or not patch:
            continue
        for task in tasks:
            if not isinstance(task, dict):
                continue
            # A new owner has a new token. Later reports from the same owner
            # cannot supersede its committed closeout.
            if task.get('id') == record['task_id'] and task.get('session_id') == record['session_id']:
                task.update(patch)
                if ((data.get('current') or {}).get('task_id') == task['id']
                        and (data.get('current') or {}).get('session_id') == record['session_id']):
                    data.update(state=patch['state'])
                    data['current']['summary'] = patch['progress']
                    if current_closeouts is not None:
                        current_closeouts.add(record['session_id'])
    data["_mtime"] = mtime_iso(path)
    return data


def project_tasks(status: dict) -> list[dict]:
    """Project-level tasks are distinct from delegated review-round history."""
    tasks = [dict(t) for t in status.get("tasks", []) if isinstance(t, dict)] if isinstance(status.get("tasks"), list) else []
    current = status.get("current") or {}
    if not isinstance(current, dict):
        current = {}
    for task in tasks:
        task["is_current"] = task.get("id") == current.get("task_id")
    active = next((t for t in tasks if t["is_current"]), None)
    if active is not None:
        own_pid = active.get("pid")
        active.update(state=status.get("state", active.get("state")),
                      progress=current.get("summary"), pid=status.get("pid"),
                      updated_at=(active.get("updated_at") if active.get("closeout_session") == current.get("session_id")
                                  and active.get("closeout_session") else status.get("_mtime") or active.get("updated_at")))
        # Owner identity is only meaningful together with the PID it was read for.
        if isinstance(status.get("process_identity"), str) and status.get("pid") is not None:
            active.update({key: status.get(key) for key in OWNER_FIELDS})
            active["lock_owned"] = status.get("lock_owned") is True
        elif own_pid != active.get("pid"):
            for key in OWNER_FIELDS:
                active.pop(key, None)
        if active.get("state") in ("done", "completed") and not active.get("completed_at"):
            active["completed_at"] = active.get("updated_at")
    elif not tasks and current.get("summary"):
        tasks.append({"id": "legacy", "is_current": True, "summary": current["summary"],
                      "state": status.get("state", "unknown"), "pid": status.get("pid"),
                      "updated_at": status.get("_mtime")})
    return tasks


def portfolio_dir() -> Path:
    return REGISTRY_PATH.parent / "portfolio"


def project_lock_path(project) -> Path:
    return Path(project) / LOCAL / "session.lock"


def lock_probe(source, cache=None) -> tuple[str, tuple | None]:
    """(state, inode) for a project's session.lock (never the Chief lock); cached per sweep."""
    if cache is not None and source in cache:
        return cache[source]
    probe = (("unknown", None) if portfolio.is_chief_record(portfolio_dir(), path=source)
             else portfolio.probe_lock_detail(project_lock_path(source)))
    if cache is not None:
        cache[source] = probe
    return probe


def lock_held(source, cache=None) -> bool:
    return lock_probe(source, cache)[0] == "held"


def lock_released(source, record: dict, cache=None) -> bool:
    """True only if the owner held session.lock for its lifetime (lock_owned),
    and the very inode it acquired (lock_inode) is now free. A replaced, unsafe,
    or unreadable lock file proves nothing."""
    expect = record.get("lock_inode")
    if record.get("lock_owned") is not True or not isinstance(expect, list) or len(expect) != 2:
        return False
    state, inode = lock_probe(source, cache)
    return state == "free" and inode is not None and list(inode) == expect


def cli_owners(*records) -> list[dict]:
    """Recorded supervised-CLI child owners (deduplicated) from task/status/session records."""
    seen, owners = set(), []
    for record in records:
        owner = record.get("cli_owner") if isinstance(record, dict) else None
        if isinstance(owner, dict):
            key = (owner.get("pid"), owner.get("process_identity"))
            if key not in seen:
                seen.add(key)
                owners.append(owner)
    return owners


def combine_owners(launcher: str, children: list[dict]) -> tuple[str, bool]:
    """Combine the launcher's verdict with its recorded CLI children.

    Any owner alive -> alive; a child that cannot be verified -> unknown;
    otherwise the launcher's verdict. The flag is True when every recorded
    child is verifiably dead (or none was recorded): only then may a released
    project lock prove the session is over.
    """
    verdicts = [portfolio.record_liveness(child) for child in children]
    if launcher == "alive" or "alive" in verdicts:
        return "alive", False
    if "unknown" in verdicts:
        return "unknown", False
    return launcher, True


def task_owner(task: dict) -> dict:
    """The owner an automatic closure applies to; a resumed task gets a new owner."""
    return {"pid": task.get("pid"), "session_id": task.get("session_id")}


def task_verdict(task: dict, status: dict, source: str, sessions: list[dict], locks: dict) -> tuple[str, str | None]:
    """Tri-state liveness for a running (or superseded waiting) task record.

    'dead' requires definitive evidence: a later launch superseded it under
    the project lock, its coordination session ended, every recorded owner
    (launcher and supervised CLI child) is proven gone in this PID namespace
    (or by a reboot of this machine), or the launcher held session.lock for
    its lifetime and that same inode is now free with no CLI child possibly
    alive. A held project lock always defers judgment of the current task.
    """
    state = task.get("state")
    current = status.get("current") if isinstance(status.get("current"), dict) else {}
    current_id = current.get("task_id")
    current_session = current.get("session_id")
    pid = task.get("pid")
    launcher_pid = isinstance(pid, int) and not isinstance(pid, bool) and pid > 0
    # The current owner session may take over an earlier task; it is then judged
    # by that session's liveness, not as superseded.
    claimed = bool(current_session) and task.get("session_id") == current_session
    if not task.get("is_current") and not claimed:
        # Only cmd_run appends tasks, and only while holding session.lock, so an
        # earlier launcher-owned task with another PID was superseded by it.
        # Sandboxed launches can share a PID (often 2); differing start identities
        # still prove different launchers.
        other_owner = pid != status.get("pid") or (
            isinstance(task.get("process_identity"), str) and isinstance(status.get("process_identity"), str)
            and task["process_identity"] != status["process_identity"])
        if state in ("running", "waiting_on_user") and current_id and launcher_pid and other_owner:
            return "dead", f"superseded by task {current_id}"
    if state != "running":
        # A current waiting_on_user task keeps its question (and stays resumable
        # by a handoff) until a later launch supersedes it.
        return "unknown", None

    def held():
        return bool(task.get("is_current") or claimed) and lock_held(source, locks)

    session = None
    if task.get("session_id"):
        session = next((s for s in sessions if s.get("id") == task["session_id"]
                        and s.get("source_path") == source), None)
    if session is None:
        session = next((s for s in reversed(sessions) if s.get("source_path") == source
                        and s.get("task_id") == task.get("id")), None)
    children = cli_owners(task, session)
    launcher = "unknown"
    if session is not None:
        if session.get("state") != "active":
            # Ended by its launcher after stopping the CLI, or by a sweep that proved it.
            return ("unknown", None) if held() else ("dead", session.get("reason") or "session exited")
        launcher = portfolio.CoordinationStore.session_liveness(session)
    if launcher == "unknown":
        launcher = portfolio.record_liveness(task)
    verdict, children_gone = combine_owners(launcher, children)
    if verdict == "alive":
        return "alive", None
    if verdict == "dead":
        return ("unknown", None) if held() else ("dead", "owner process exited")
    if task.get("is_current") and children_gone and lock_released(source, task, locks):
        return "dead", "owner process exited (project lock released)"
    return "unknown", None


def reconcile_sessions(write: bool = True) -> list[dict]:
    """End coordination sessions whose owners are definitively gone, exactly as
    end_session does (queued requests fail). Chief records are never touched.
    With write=False nothing is ended (read-only views). Returns the session
    list, or [] when coordination state is unavailable."""
    store = coordination_store()
    pdir = portfolio_dir()
    locks: dict = {}

    def verdict(session):
        source = session.get("source_path")
        if not isinstance(source, str) or portfolio.is_chief_record(pdir, path=source, record=session):
            return False
        status = read_status(source) or {}
        current = status.get("current") if isinstance(status.get("current"), dict) else {}
        owns_current = current.get("task_id") == session.get("task_id")
        same_session = owns_current and current.get("session_id") == session.get("id")
        liveness, children_gone = combine_owners(store.session_liveness(session),
                                                 cli_owners(session, status if same_session else None))
        if liveness == "alive":
            return False
        if liveness == "dead":
            # A held lock means the process tree, or a relaunch, may still own the task.
            return not (owns_current and lock_held(source, locks))
        return same_session and children_gone and lock_released(source, status, locks)

    if write:
        try:
            store.reconcile(verdict)
        except (portfolio.PortfolioError, OSError) as error:
            print(f"syndicate: could not persist session reconciliation: {error}; "
                  "rerun outside the sandbox with approval", file=sys.stderr)
    try:
        return store.read()["sessions"]
    except (portfolio.PortfolioError, OSError):
        return []


def persist_task_closures(closures: list[tuple[str, str, dict]]) -> None:
    """Record automatic closures in the independent task-edits overlay, which an
    agent's own status.json writes cannot overwrite. Idempotent per owner."""
    try:
        with registry_lock():
            path = REGISTRY_PATH.parent / "task-edits.json"
            edits = runtime.read_json(path)
            changed = False
            for source, task_id, closure in closures:
                entry = edits.setdefault(source, {}).setdefault(task_id, {})
                if "state" in entry or (entry.get("auto_end") or {}).get("owner") == closure["owner"]:
                    continue  # explicit edits stay authoritative
                entry["auto_end"] = closure
                changed = True
            if changed:
                runtime.atomic_json(path, edits)
    except OSError as error:
        print(f"syndicate: could not persist task closures: {error}; "
              "rerun outside the sandbox with approval", file=sys.stderr)


def gather_statuses(sweep: bool = True) -> list[dict]:
    """One row per registered project, reconciling stale ownership on the way.

    A running task whose owner is definitively gone is closed as 'ended'
    (never 'done') through the task-edits overlay; one whose owner cannot be
    verified from here (another PID namespace, no identity) stays as reported
    with liveness 'unknown'. Chief of Staff records are never evaluated.
    With sweep=False (web GET handlers) the same verdicts are shown but
    nothing is written."""
    rows = []
    overrides = runtime.read_json(REGISTRY_PATH.parent / "task-edits.json")
    sessions = reconcile_sessions(write=sweep)
    locks: dict = {}
    closures = []
    pdir = portfolio_dir()
    for entry in load_registry():
        status = read_status(entry.get("path", ""))
        source = entry["path"]
        # Decided by the resolved source path only; status content cannot claim it.
        chief = portfolio.is_chief_record(pdir, path=source)
        row = {"path": entry.get("group_path", source), "name": "Generic tasks" if entry.get("group_path") else entry.get("name") or Path(source).name,
               "status_available": status is not None}
        if status is None:
            row.update(state="unknown", current=None, history=[], updated_at=None)
        else:
            row.update(
                state=status.get("state") if status.get("state") in STATUS_STATES else "unknown",
                current=status.get("current"),
                history=status.get("history") if isinstance(status.get("history"), list) else [],
                updated_at=status.get("_mtime"),
            )
        tasks = project_tasks(status or {})
        for task in tasks:
            task["source_path"] = source
            edit = dict(overrides.get(source, {}).get(task.get("id"), {}))
            auto = edit.pop("auto_end", None)
            raw_state, owner = task.get("state"), task_owner(task)
            if (not chief and "state" not in edit
                    and raw_state in ("running", "waiting_on_user")):
                verdict, reason = task_verdict(task, status, source, sessions, locks)
                if raw_state == "running":
                    task["liveness"] = verdict
                if verdict == "dead" and not (isinstance(auto, dict) and auto.get("owner") == owner):
                    auto = {"state": ENDED, "last_state": raw_state, "ended_at": now_iso(),
                            "end_reason": reason, "owner": owner}
                    closures.append((source, task.get("id"), auto))
            task.update(edit)
            if (not chief and isinstance(auto, dict) and "state" not in edit and auto.get("owner") == owner
                    and auto.get("last_state") == raw_state):
                task.update(state=ENDED, last_state=raw_state, ended_at=auto.get("ended_at"),
                            end_reason=auto.get("end_reason"))
                task.pop("liveness", None)
            if task.get("is_current") and row["state"] == "running" and task.get("state") == ENDED:
                row["state"] = ENDED
        row["all_tasks"] = tasks
        rows.append(row)
    if closures and sweep:
        persist_task_closures(closures)
    grouped = {}
    for row in rows:
        grouped.setdefault(row["path"], {**row, "all_tasks": [], "history": []})
        grouped[row["path"]]["history"].extend(row["history"])
        for task in row["all_tasks"]:
            target = task.get("project_path") or row["path"]
            group = grouped.setdefault(target, {"path": target, "name": "Generic tasks" if target == str(REGISTRY_PATH.parent / "generic-tasks") else Path(target).name,
                                                "all_tasks": [], "history": [], "state": "unknown", "current": None, "updated_at": None})
            group["all_tasks"].append(task)
            group["updated_at"] = max(group.get("updated_at") or "", task.get("updated_at") or "") or None
    rows = []
    for row in grouped.values():
        tasks = row.pop("all_tasks")
        # Per group, not copied from its first member: any unverifiable current owner.
        row.pop("liveness", None)
        if any(t.get("is_current") and t.get("state") == "running" and t.get("liveness") == "unknown" for t in tasks):
            row["liveness"] = "unknown"
        unfinished = [t for t in tasks if t.get("state") not in (*DONE_STATES, ENDED)]
        completed = sorted((t for t in tasks if t.get("state") in DONE_STATES),
                           key=lambda t: t.get("completed_at") or t.get("updated_at") or "", reverse=True)
        ended = sorted((t for t in tasks if t.get("state") == ENDED),
                       key=lambda t: t.get("ended_at") or t.get("updated_at") or "", reverse=True)
        attention = {"waiting_on_user", "on_hold", "blocked", "failed", "unknown"}
        unfinished.sort(key=lambda t: (0 if t.get("state") in attention else 1 if t.get("state") == "running" else 2))
        label = ("Needs attention" if any(t.get("state") in attention for t in unfinished) or any(t.get("needs_attention") for t in ended)
                 else "Working" if any(t.get("state") == "running" for t in unfinished)
                 else "Queued" if unfinished else "Complete" if completed
                 else "No tasks" if ended or row.get("status_available") or not status_path(Path(row["path"])).exists()
                 else "Needs attention")
        row.update(tasks=unfinished, unfinished_count=len(unfinished),
                   last_completed=completed[0] if completed else None, project_status=label,
                   completed_tasks=completed, ended_tasks=ended)
        rows.append(row)
    priority = {"Needs attention": 0, "Working": 1, "Queued": 2, "Complete": 3, "No tasks": 4}
    return sorted(rows, key=lambda r: (priority[r["project_status"]], r["name"].lower(), r["path"]))


def reconcile_stale() -> list[dict] | None:
    """Safe-point sweep before launching or listing ownership; never blocks the
    caller. Returns the swept rows, or None if the sweep failed."""
    try:
        return gather_statuses()
    except Exception:  # a failed sweep must never prevent a launch or listing
        return None


def assignment_rows() -> list[dict]:
    """Rows for mapping live sessions to their projects: one sweep, or a
    read-only view if the sweep fails, so assignments are never lost and a
    duplicate team is not launched. [] only if neither can be read."""
    rows = reconcile_stale()
    if rows is not None:
        return rows
    try:
        return gather_statuses(sweep=False)
    except Exception:
        return []


def decision_store():
    return portfolio.DecisionStore(REGISTRY_PATH.parent / "portfolio")


def coordination_store():
    return portfolio.CoordinationStore(REGISTRY_PATH.parent / "portfolio")


def session_label(session) -> str:
    """Unverifiable ownership (e.g. another PID namespace) is not reported as inactive."""
    return ("active" if session.get("live") else
            "unverified" if session.get("liveness") == "unknown" else "inactive")


def project_briefing(sweep: bool = True):
    rows = gather_statuses(sweep=sweep)
    return portfolio.briefing(rows, decision_store().read(), coordination_store().snapshot(strict=False),
                              portfolio.chief_status(REGISTRY_PATH.parent / "portfolio"))


def task_project(source, task_id, rows=None):
    for row in gather_statuses() if rows is None else rows:
        if any(t.get("id") == task_id and t.get("source_path") == str(source)
               for t in row["tasks"] + row["completed_tasks"] + row.get("ended_tasks", [])):
            return row["path"]
    return str(source)


def cmd_briefs(args):
    store = coordination_store()
    if args.action == "list":
        records = list(store.read()["briefs"].values())
    else:
        project = str(resolve_project(args.project))
        if args.action == "show":
            records = [store.read()["briefs"].get(project)]
            records = [record for record in records if record]
        else:
            changes = {}
            for field in ("goal", "priority", *portfolio.BRIEF_LIST_FIELDS):
                value = getattr(args, field, None)
                if value is not None:
                    changes[field] = value
            for field in args.clear:
                if field in changes:
                    raise SyndicateError(f"Cannot set and clear {field} together")
                changes[field] = [] if field in portfolio.BRIEF_LIST_FIELDS else None if field == "priority" else ""
            records = [store.update_brief(project, changes, args.revision)]
    if args.json or args.action == "update":
        portfolio_print(json.dumps(records[0] if args.action != "list" and records else records, indent=2))
    elif not records:
        portfolio_print("No project brief recorded.")
    else:
        for brief in records:
            portfolio_print(f"{brief['project_path']} / revision {brief['revision']} / priority {brief['priority'] or 'unset'}")
            portfolio_print("  Goal: " + brief["goal"])
            for field in portfolio.BRIEF_LIST_FIELDS:
                for value in brief[field]:
                    portfolio_print(f"  {field.replace('_', ' ').title()}: {value}")
    return 0


def execution_project(value):
    if value == 'generic':
        directory = REGISTRY_PATH.parent / 'generic-tasks'
        directory.mkdir(parents=True, exist_ok=True)
        return directory
    candidate = Path(value).expanduser()
    if candidate.is_dir():
        root = git(candidate.resolve(), 'rev-parse', '--show-toplevel')
        return Path(root).resolve() if root else candidate.resolve()
    return resolve_project(value)


def tmux_enabled():
    path = user_config_path()
    roles, _ = load_roles(Path.cwd())
    values = parse_config_file(path, roles) if path.is_file() else {}
    return values.get('tmux', CONFIG_DEFAULTS['tmux']) == 'on'


@contextmanager
def chief_session_lock(probe=False):
    """One user-wide PID lock, held by the supervisor in either execution mode.

    The kernel lock is authoritative: stale contents or a reused PID cannot
    block recovery after a crash. Keep the inode so concurrent openers always
    contend on the same lock, including while an owner is exiting.
    """
    import fcntl
    path = REGISTRY_PATH.parent / 'portfolio' / 'chief-of-staff.lock'
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, _ = portfolio.open_lock(path, create=True, writable=not probe)
    except OSError as error:
        raise SyndicateError(f'cannot open Chief of Staff lock safely: {error}') from None
    with os.fdopen(fd, 'r+' if not probe else 'r', encoding='ascii', errors='replace') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.seek(0)
            pid = lock.readline(64).strip()
            detail = f' (PID {pid})' if pid.isdecimal() else ''
            raise SyndicateError(f'another Chief of Staff session is already running{detail}') from None
        try:
            if not probe:
                lock.seek(0)
                lock.truncate()
                lock.write(f'{os.getpid()}\n')
                lock.flush()
            yield lock
        finally:
            if not probe:
                lock.seek(0)
                lock.truncate()
                lock.flush()
            fcntl.flock(lock, fcntl.LOCK_UN)


def report_usage_reserve(args, project, handoff, reason=None):
    if reason is None:
        if runtime.limited_provider(project, handoff) is None:
            return
        reason = runtime.read_json(project / LOCAL / 'handoff.json')['reason']
    print(f"\nSyndicate stopped at the usage reserve.\n{reason.rstrip('.')}.\n"
          f"Handoff saved: {handoff}", file=sys.stderr, flush=True)
    pane = os.environ.get('TMUX_PANE', '')
    if getattr(args, 'inside_tmux', False) and not args.print and re.fullmatch(r'%[0-9]+', pane):
        # Keep only reserve-stopped panes available to the attached or detached user.
        try:
            subprocess.run(['tmux', 'set-option', '-p', '-t', pane, '@syndicate-usage-reserve', '1',
                            ';', 'set-option', '-p', '-t', pane, 'remain-on-exit', 'on'],
                           capture_output=True, text=True, check=True)
        except (OSError, subprocess.CalledProcessError) as error:
            detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) else str(error)
            print(f"Syndicate could not retain the tmux pane: {detail}", file=sys.stderr, flush=True)


def _tmux(args, socket=None, **kwargs):
    command = ['tmux']
    if socket:
        command += ['-L', socket]
    return subprocess.run([*command, *args], capture_output=True, text=True, **kwargs)


def _tmux_session_exists(socket=None):
    return _tmux(['has-session', '-t', TMUX_SESSION], socket=socket).returncode == 0


def _window_listing(socket=None):
    """Windows in the syndicate session, oldest index first."""
    listed = _tmux(['list-windows', '-t', TMUX_SESSION, '-F',
                    '#{window_id}\t#{window_name}\t#{window_active}\t#{pane_dead}\t'
                    '#{pane_current_command}\t#{pane_current_path}'], socket=socket)
    if listed.returncode:
        raise SyndicateError(listed.stderr.strip() or f'tmux session {TMUX_SESSION} could not be inspected')
    rows = []
    for line in listed.stdout.splitlines():
        parts = line.split('\t')
        if len(parts) < 2 or not parts[0]:
            continue
        rows.append({
            'id': parts[0],
            'name': parts[1],
            'active': len(parts) > 2 and parts[2] == '1',
            'dead': len(parts) > 3 and parts[3] == '1',
            'command': parts[4] if len(parts) > 4 else '',
            'path': parts[5] if len(parts) > 5 else '',
        })
    return rows


def _tmux_windows(name, socket=None):
    """Ids of windows in the syndicate session whose name is exactly `name`."""
    return [row['id'] for row in _window_listing(socket) if row['name'] == name]


def _workers_in_view(socket=None, listing=None):
    """Worker name to pane id for panes parked in the side-by-side view."""
    if listing is None:
        listing = _window_listing(socket)
    held = {}
    for row in listing:
        if row['name'] != VIEW_WINDOW:
            continue
        panes = _tmux(['list-panes', '-t', row['id'], '-F',
                       '#{pane_id}\t#{@syndicate-worker}\t#{pane_dead}\t'
                       '#{pane_current_command}\t#{pane_current_path}'], socket=socket)
        if panes.returncode:
            continue
        for line in panes.stdout.splitlines():
            parts = line.split('\t')
            if len(parts) < 2 or not parts[0].startswith('%') or not parts[1]:
                continue
            held[parts[1]] = {
                'pane': parts[0],
                'dead': len(parts) > 2 and parts[2] == '1',
                'command': parts[3] if len(parts) > 3 else '',
                'path': parts[4] if len(parts) > 4 else '',
            }
    return held


def _window_replaceable(name, window_id, socket=None):
    """A dead chief window, or a dead usage-reserve window, may be replaced.

    Anything still running stays. Replacement closes that window only.
    """
    panes = _tmux(['list-panes', '-t', window_id, '-F', '#{pane_dead}:#{@syndicate-usage-reserve}'], socket=socket)
    if panes.returncode:
        return False
    rows = [line.split(':', 1) for line in panes.stdout.splitlines()]
    if not rows or any(len(row) != 2 or row[0] != '1' for row in rows):
        return False
    return name == CHIEF_TMUX_WINDOW or all(row[1] == '1' for row in rows)


def _window_busy(name, in_view=False):
    message = (f'tmux window {name} already exists in session {TMUX_SESSION}; '
               'inspect or attach to it before launching again')
    if in_view:
        message += '. It is open in a side-by-side view; run syndicate detach to restore its window'
    raise SyndicateError(message)


def _tmux_env_flags():
    # A tmux server may predate the user's current configuration environment.
    # SYNDICATE_RUN_ID is reset too, so a server started inside an earlier run
    # cannot leak a stale run id into this window.
    flags = []
    for key in ('XDG_CONFIG_HOME', 'SYNDICATE_RUNTIME', 'PATH', runtime.RUN_ENV):
        flags += ['-e', f'{key}={os.environ.get(key, "")}']
    return flags


def _start_tmux_window(directory, name, command, socket=None, **run_kwargs):
    """Open `name` in the syndicate session, creating the session only if it is absent."""
    env = _tmux_env_flags()
    common = ['-n', name, '-c', str(directory), *env, '-P', '-F', '#{window_id}', command]

    def create(kind):
        if kind == 'new-session':
            argv = ['new-session', '-d', '-s', TMUX_SESSION, *common]
        else:
            argv = ['new-window', '-d', '-t', TMUX_SESSION, *common]
        return _tmux(argv, socket=socket, **run_kwargs)

    kind = 'new-window' if _tmux_session_exists(socket) else 'new-session'
    result = create(kind)
    if result.returncode and kind == 'new-session' and _tmux_session_exists(socket):
        # Another launch created the session between the check and new-session.
        result = create('new-window')
    if result.returncode:
        raise SyndicateError(result.stderr.strip() or f'could not open tmux window {name}')
    window_id = result.stdout.strip()
    if not window_id.startswith('@'):
        raise SyndicateError(result.stderr.strip() or f'tmux did not report a window id for {name}')
    # Window names are not unique in tmux. Drop the window we just opened when
    # another one with this name is already there, so chief-of-staff stays singular.
    others = [wid for wid in _tmux_windows(name, socket) if wid != window_id]
    if others:
        _tmux(['kill-window', '-t', window_id], socket=socket)
        _window_busy(name)
    return window_id


def _release_replaced_windows(name, socket=None):
    """Close dead windows of this name so the next launch can open exactly one."""
    if not _tmux_session_exists(socket):
        return
    if name in _workers_in_view(socket):
        _window_busy(name, in_view=True)
    windows = _tmux_windows(name, socket)
    if not windows:
        return
    if not all(_window_replaceable(name, window_id, socket) for window_id in windows):
        _window_busy(name)
    for window_id in windows:
        removed = _tmux(['kill-window', '-t', window_id], socket=socket)
        if removed.returncode:
            raise SyndicateError(removed.stderr.strip() or f'could not replace tmux window {name}')


def launch_tmux(argv, directory, name, headless=False, socket=None):
    """Run the launcher in one window of the shared `the-syndicate` session.

    Windows are the orchestration unit: Chief of Staff and each team are
    independent CLIs, so each launch is its own window. The session is created
    on first use and reused after that. A window keeps the single pane tmux
    opens for its command. That pane is marked when a usage reserve stops the
    CLI; panes are not used to split chief of staff from teams.
    """
    if not shutil.which('tmux'):
        raise SyndicateError('tmux is required; install it or set tmux = off in the global config')
    _release_replaced_windows(name, socket)
    command = shlex.join([sys.executable, str(SCRIPT), '_in-tmux', *argv])
    target = f'{TMUX_SESSION}:{name}'
    if not headless:
        _start_tmux_window(directory, name, command, socket=socket)
        attach = ['tmux']
        if socket:
            attach += ['-L', socket]
        attach += ['attach-session', '-t', target]
        print(f'Launch requested in tmux session {TMUX_SESSION}, window {name}. Show it with: '
              f'{shlex.join(["syndicate", "show", name])}')
        if sys.stdin.isatty() and sys.stdout.isatty() and not os.environ.get('TMUX'):
            _arm_detach_binding(socket)
            return subprocess.run(attach).returncode
        return 0
    with tempfile.TemporaryDirectory(prefix='syndicate-tmux-') as tmp:
        output, errors, code = (Path(tmp) / part for part in ('stdout', 'stderr', 'exit'))
        shell = (f'{command} >{shlex.quote(str(output))} 2>{shlex.quote(str(errors))}; '
                 f'result=$?; printf "%s" "$result" >{shlex.quote(str(code) + ".tmp")}; '
                 f'mv {shlex.quote(str(code) + ".tmp")} {shlex.quote(str(code))}')
        with runtime.specialist_signals() as check_interrupt:
            window_id = None
            try:
                try:
                    window_id = _start_tmux_window(
                        directory, name, shlex.join(['/bin/sh', '-c', shell]),
                        socket=socket, start_new_session=True)
                except SyndicateError:
                    check_interrupt()
                    raise
                while not code.exists():
                    check_interrupt()
                    time.sleep(0.1)
                    if _tmux(['list-panes', '-t', window_id], socket=socket).returncode and not code.exists():
                        check_interrupt()
                        raise SyndicateError(f'tmux window {name} exited without a result')
                check_interrupt()
                sys.stdout.write(output.read_text())
                sys.stderr.write(errors.read_text())
                return int(code.read_text())
            finally:
                # Close only this run's window. The shared session and any other
                # team or chief window stay up. The last window takes the session with it.
                if window_id:
                    _tmux(['kill-window', '-t', window_id], socket=socket)


def _require_tmux():
    if not shutil.which('tmux'):
        raise SyndicateError('tmux is required; install it or set tmux = off in the global config')


def _require_session(socket=None):
    _require_tmux()
    if not _tmux_session_exists(socket):
        raise SyndicateError(f'no {TMUX_SESSION} session is running')


@contextmanager
def _view_lock(socket=None):
    locked = _tmux(['wait-for', '-L', 'syndicate-view'], socket=socket)
    if locked.returncode:
        raise SyndicateError(locked.stderr.strip() or 'could not lock the syndicate view')
    try:
        yield
    finally:
        _tmux(['wait-for', '-U', 'syndicate-view'], socket=socket)


def _view_hook(socket=None):
    command = [sys.executable, str(SCRIPT), '_restore-view']
    if socket:
        command += ['--socket', socket]
    return 'run-shell ' + shlex.quote(shlex.join(command))


def _arm_view_hooks(socket=None):
    hook = _view_hook(socket)
    held = _tmux(['set-option', '-t', TMUX_SESSION, '@syndicate-view-hold',
                  str(int(time.time()) + VIEW_HOLD_SECONDS)], socket=socket)
    if held.returncode:
        raise SyndicateError(held.stderr.strip() or 'could not arm the side-by-side view')
    for name in ('client-detached', 'session-window-changed'):
        armed = _tmux(['set-hook', '-t', TMUX_SESSION, name, hook], socket=socket)
        if armed.returncode:
            raise SyndicateError(armed.stderr.strip() or 'could not arm the side-by-side view')


def _clear_view_hooks(socket=None):
    for name in ('client-detached', 'session-window-changed'):
        _tmux(['set-hook', '-u', '-t', TMUX_SESSION, name], socket=socket)
    _tmux(['set-option', '-u', '-t', TMUX_SESSION, '@syndicate-view-hold'], socket=socket)


def _view_hold(socket=None):
    shown = _tmux(['show-options', '-t', TMUX_SESSION, '-v', '@syndicate-view-hold'], socket=socket)
    value = shown.stdout.strip() if shown.returncode == 0 else ''
    return int(value) if value.isdigit() else 0


def _view_clients(socket=None, listing=None):
    if listing is None:
        listing = _window_listing(socket)
    views = [row['id'] for row in listing if row['name'] == VIEW_WINDOW]
    if not views:
        return 0
    shown = _tmux(['display-message', '-t', views[0], '-p', '#{window_active_clients}'], socket=socket)
    value = shown.stdout.strip() if shown.returncode == 0 else ''
    return int(value) if value.isdigit() else 0


def _restore_view_unlocked(socket=None, force=False):
    """Put side-by-side workers back in their own windows. The view is not a worker."""
    if not _tmux_session_exists(socket):
        return
    if not force and (time.time() < _view_hold(socket) or _view_clients(socket) > 0):
        return
    for name, pane in _workers_in_view(socket).items():
        restored = _tmux(['break-pane', '-d', '-n', name, '-s', pane['pane'], '-t', TMUX_SESSION + ':'],
                         socket=socket)
        if restored.returncode:
            raise SyndicateError(restored.stderr.strip() or f'could not restore worker {name}')
        _tmux(['set-option', '-p', '-u', '-t', pane['pane'], '@syndicate-worker'], socket=socket)
    for row in _window_listing(socket):
        if row['name'] == VIEW_WINDOW:
            _tmux(['kill-window', '-t', row['id']], socket=socket)
    _clear_view_hooks(socket)


def restore_worker_view(socket=None, force=False):
    with _view_lock(socket):
        _restore_view_unlocked(socket, force=force)


def worker_records(socket=None):
    """Workers in the syndicate session, or None when that session does not exist."""
    _require_tmux()
    if not _tmux_session_exists(socket):
        return None
    listing = _window_listing(socket)
    held = _workers_in_view(socket, listing)
    records = []
    for row in listing:
        if row['name'] == VIEW_WINDOW:
            continue
        records.append({
            'name': row['name'],
            'state': 'exited' if row['dead'] else 'live',
            'command': row['command'],
            'path': row['path'],
            'active': row['active'],
        })
    for name, pane in held.items():
        if any(record['name'] == name for record in records):
            continue
        records.append({
            'name': name,
            'state': 'exited' if pane['dead'] else 'side-by-side',
            'command': pane['command'],
            'path': pane['path'],
            'active': False,
        })
    return records


def format_worker_table(records):
    if not records:
        return f'No workers in {TMUX_SESSION}.'
    width = max(len(record['name']) for record in records)
    lines = []
    for record in records:
        marker = '*' if record['active'] else ' '
        command = record['command'] or '-'
        path = record['path'] or '-'
        lines.append(f"{marker} {record['name']:<{width}}  {record['state']:<12}  {command}  {path}")
    return '\n'.join(lines)


def _known_worker_names(socket=None):
    return [record['name'] for record in (worker_records(socket) or [])]


def _missing_worker(name, socket=None):
    running = ', '.join(_known_worker_names(socket)) or 'none'
    raise SyndicateError(f'no worker {name!r} in {TMUX_SESSION}; running: {running}')


def _arm_detach_binding(socket=None):
    """Let F12 leave a syndicate view without sending a key to the worker.

    Ctrl-b often never reaches tmux: Cursor and VS Code use it to toggle the
    sidebar, and a worker prompt would consume it if it did. F12 is bound in
    tmux's root table, so the worker process is not involved. Other tmux
    sessions still receive F12.
    """
    listed = _tmux(['list-keys', '-T', 'root', 'F12'], socket=socket)
    current = listed.stdout or ''
    foreign = listed.returncode == 0 and current.strip() and TMUX_SESSION not in current
    if not foreign:
        bound = _tmux(['bind-key', '-T', 'root', '-n', 'F12',
                       'if-shell', '-F', '#{==:#{session_name},' + TMUX_SESSION + '}',
                       'detach-client', 'send-keys F12'], socket=socket)
        if bound.returncode:
            raise SyndicateError(bound.stderr.strip() or 'could not bind the view detach key')
    hint = (' F12 detaches · worker keeps running ' if not foreign
            else ' syndicate detach · from another terminal ')
    for option, value in (('extended-keys', 'on'), ('status', 'on'), ('status-right', hint)):
        set_option = _tmux(['set-option', '-t', TMUX_SESSION, option, value], socket=socket)
        if set_option.returncode:
            raise SyndicateError(set_option.stderr.strip() or 'could not prepare the syndicate view')
    noted = _tmux(['set-hook', '-t', TMUX_SESSION, 'client-attached',
                   'display-message -d 8000 "F12 leaves this view; the worker keeps running"'],
                  socket=socket)
    if noted.returncode:
        raise SyndicateError(noted.stderr.strip() or 'could not prepare the syndicate view')


def focus_target(target, socket=None):
    """Attach to a syndicate target, or switch the current tmux client onto it."""
    _arm_detach_binding(socket)
    if os.environ.get('TMUX') and not socket:
        switched = _tmux(['switch-client', '-t', target], socket=socket)
        if switched.returncode:
            raise SyndicateError(switched.stderr.strip() or f'could not show {target}')
        return 0
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        if target == TMUX_SESSION:
            hint = 'syndicate attach'
        else:
            hint = 'syndicate show ' + target.split(':', 1)[-1]
        raise SyndicateError(f'a terminal is required to show workers; from a terminal run: {hint}')
    attach = ['tmux']
    if socket:
        attach += ['-L', socket]
    attach += ['attach-session', '-t', target]
    return subprocess.run(attach).returncode


def open_worker_view(names, socket=None):
    """Move each named worker into one window, side by side for two and tiled beyond that."""
    with _view_lock(socket):
        try:
            _restore_view_unlocked(socket, force=True)
            listing = _window_listing(socket)
            panes = []
            for name in names:
                ids = [row['id'] for row in listing if row['name'] == name]
                if len(ids) != 1:
                    _missing_worker(name, socket)
                listed = _tmux(['list-panes', '-t', ids[0], '-F', '#{pane_id}'], socket=socket)
                found = [line for line in (listed.stdout or '').splitlines() if line]
                if listed.returncode or len(found) != 1:
                    raise SyndicateError(f'worker {name} has {len(found)} panes; syndicate expects one pane per worker')
                marked = _tmux(['set-option', '-p', '-t', found[0], '@syndicate-worker', name], socket=socket)
                if marked.returncode:
                    raise SyndicateError(marked.stderr.strip() or f'could not mark worker {name}')
                panes.append(found[0])
            created = _tmux(['new-window', '-d', '-t', TMUX_SESSION, '-n', VIEW_WINDOW, '-P', '-F',
                             '#{window_id}\t#{pane_id}', '/bin/sleep 86400'], socket=socket)
            if created.returncode:
                raise SyndicateError(created.stderr.strip() or 'could not open the side-by-side view')
            window_id, separator, sleep_pane = created.stdout.strip().partition('\t')
            if not separator or not window_id.startswith('@') or not sleep_pane.startswith('%'):
                raise SyndicateError('tmux did not report the side-by-side view')
            for pane in panes:
                joined = _tmux(['join-pane', '-d', '-h', '-s', pane, '-t', window_id], socket=socket)
                if joined.returncode:
                    raise SyndicateError(joined.stderr.strip() or 'could not arrange the side-by-side view')
            removed = _tmux(['kill-pane', '-t', sleep_pane], socket=socket)
            if removed.returncode:
                raise SyndicateError(removed.stderr.strip() or 'could not open the side-by-side view')
            layout = 'even-horizontal' if len(names) == 2 else 'tiled'
            laid = _tmux(['select-layout', '-t', window_id, layout], socket=socket)
            if laid.returncode:
                raise SyndicateError(laid.stderr.strip() or 'could not arrange the side-by-side view')
            _arm_view_hooks(socket)
        except SyndicateError:
            try:
                _restore_view_unlocked(socket, force=True)
            except SyndicateError:
                raise
            raise


def show_workers(names, socket=None):
    if len(names) != len(set(names)):
        raise SyndicateError('name each worker once')
    if VIEW_WINDOW in names:
        raise SyndicateError(f'{VIEW_WINDOW} is the side-by-side view, not a worker')
    _require_session(socket)
    restore_worker_view(socket, force=True)
    missing = [name for name in names if name not in set(_known_worker_names(socket))]
    if missing:
        _missing_worker(missing[0], socket)
    if len(names) == 1:
        return focus_target(f'{TMUX_SESSION}:{names[0]}', socket=socket)
    open_worker_view(names, socket=socket)
    target = f'{TMUX_SESSION}:{VIEW_WINDOW}'
    # Inside tmux, switch the current client and let the view hooks restore workers
    # when that client leaves. Outside, attach and restore when the client detaches.
    if os.environ.get('TMUX') and not socket:
        return focus_target(target, socket=socket)
    try:
        return focus_target(target, socket=socket)
    finally:
        restore_worker_view(socket, force=True)


def message_worker(name, text, socket=None, submit=True):
    """Type text into a running worker. Enter is sent unless submit is false.

    The text is literal, so words such as Enter are not interpreted as keys.
    """
    _require_session(socket)
    if name == VIEW_WINDOW:
        raise SyndicateError('that is the side-by-side view, not a worker')
    if not text or not text.strip():
        raise SyndicateError('message text is required')
    held = _workers_in_view(socket)
    if name in held:
        pane = held[name]
        if pane['dead']:
            raise SyndicateError(f'worker {name} is not running')
        target = pane['pane']
    else:
        rows = [row for row in _window_listing(socket) if row['name'] == name]
        if len(rows) != 1:
            _missing_worker(name, socket)
        if rows[0]['dead']:
            raise SyndicateError(f'worker {name} is not running')
        target = f'{TMUX_SESSION}:{name}'
    literal = _tmux(['send-keys', '-t', target, '-l', '--', text], socket=socket)
    if literal.returncode:
        raise SyndicateError(literal.stderr.strip() or f'could not message {name}')
    if not submit:
        return
    entered = _tmux(['send-keys', '-t', target, 'Enter'], socket=socket)
    if entered.returncode:
        raise SyndicateError(entered.stderr.strip() or f'could not message {name}')


def capture_worker(name, lines, socket=None):
    _require_session(socket)
    held = _workers_in_view(socket)
    if name in held:
        target = held[name]['pane']
    elif _tmux_windows(name, socket):
        target = f'{TMUX_SESSION}:{name}'
    else:
        _missing_worker(name, socket)
        return ''
    captured = _tmux(['capture-pane', '-p', '-J', '-t', target, '-S', f'-{lines}'], socket=socket)
    if captured.returncode:
        raise SyndicateError(captured.stderr.strip() or f'could not capture {name}')
    return captured.stdout


def close_worker(name, force=False, socket=None):
    _require_session(socket)
    if name == VIEW_WINDOW:
        raise SyndicateError('that is the side-by-side view; run syndicate detach to restore its workers')
    if name == CHIEF_TMUX_WINDOW and not force:
        raise SyndicateError('closing chief-of-staff stops the Chief; pass --force to close it')
    with _view_lock(socket):
        held = _workers_in_view(socket)
        if name in held:
            killed = _tmux(['kill-pane', '-t', held[name]['pane']], socket=socket)
            if killed.returncode:
                raise SyndicateError(killed.stderr.strip() or f'could not close {name}')
            remaining = _workers_in_view(socket)
            if len(remaining) <= 1:
                _restore_view_unlocked(socket, force=True)
            else:
                layout = 'even-horizontal' if len(remaining) == 2 else 'tiled'
                views = [row['id'] for row in _window_listing(socket) if row['name'] == VIEW_WINDOW]
                if views:
                    laid = _tmux(['select-layout', '-t', views[0], layout], socket=socket)
                    if laid.returncode:
                        raise SyndicateError(laid.stderr.strip() or 'could not rearrange the side-by-side view')
            return
        ids = _tmux_windows(name, socket)
        if len(ids) != 1:
            _missing_worker(name, socket)
        killed = _tmux(['kill-window', '-t', ids[0]], socket=socket)
        if killed.returncode:
            raise SyndicateError(killed.stderr.strip() or f'could not close {name}')


def detach_workers(socket=None):
    _require_session(socket)
    _tmux(['detach-client', '-s', TMUX_SESSION], socket=socket)
    restore_worker_view(socket, force=True)


def cmd_list_workers(args):
    records = worker_records()
    if records is None:
        message = f'No workers. Session {TMUX_SESSION} is not running.'
        if args.json:
            print(message, file=sys.stderr)
            print('[]')
        else:
            print(message)
        return 0
    if args.json:
        print(json.dumps(records, indent=2))
        return 0
    print(format_worker_table(records))
    return 0


def cmd_show_workers(args):
    return show_workers(args.workers)


def cmd_attach_workers(args):
    _require_session()
    return focus_target(TMUX_SESSION)


def cmd_message_worker(args):
    message_worker(args.worker, ' '.join(args.text), submit=not args.no_submit)
    print(f'Sent to {args.worker}.')
    return 0


def cmd_capture_worker(args):
    if args.lines < 1 or args.lines > 5000:
        raise SyndicateError('--lines must be between 1 and 5000')
    sys.stdout.write(capture_worker(args.worker, args.lines))
    return 0


def cmd_close_worker(args):
    close_worker(args.worker, force=args.force)
    print(f'Closed {args.worker}.')
    return 0


def cmd_detach_workers(args):
    detach_workers()
    print(f'Detached from {TMUX_SESSION}.')
    return 0


def cmd_task(args):
    project = execution_project(args.project or str(Path.cwd()))
    rows = assignment_rows()  # one sweep, reused for every live session
    for session in coordination_store().snapshot()['sessions']:
        if session['live'] and (session['source_path'] == str(project)
                               or task_project(Path(session['source_path']), session['task_id'], rows) == str(project)):
            print(f"Team already running: {session['id']} / task {session['task_id']}")
            return 0
    args.dir = str(project)
    return cmd_run(args)


def cmd_sessions(args):
    reconcile_stale()
    records = coordination_store().snapshot(strict=False)["sessions"]
    if args.project:
        target = str(resolve_project(args.project))
        records = [record for record in records if record["source_path"] == target
                   or task_project(Path(record["source_path"]), record["task_id"]) == target]
    if not args.all:
        latest = {}
        for record in records:
            latest[record["source_path"]] = record
        records = list(latest.values())
    if args.json:
        portfolio_print(json.dumps(records, indent=2))
    else:
        for record in records:
            portfolio_print(f"{record['id']} [{session_label(record)}] {record['provider']} / PID {record['pid']}")
            portfolio_print(f"  {record['source_path']} / task {record['task_id']}")
        if not records:
            portfolio_print("No sessions recorded.")
    return 0


def cmd_requests(args):
    store = coordination_store()
    if args.action == "list":
        records = store.snapshot(strict=False)["requests"]
        if not args.all:
            records = [r for r in records if r["state"] in ("queued", "failed")]
        if args.project:
            project = str(resolve_project(args.project))
            records = [r for r in records if r["project_path"] == project]
        if args.dir:
            source = Path(args.dir).expanduser().resolve()
            source = Path(git(source, "rev-parse", "--show-toplevel") or source).resolve()
            records = [r for r in records if r["source_path"] == str(source)]
        if args.task:
            records = [r for r in records if r["task_id"] == args.task]
        if args.json:
            portfolio_print(json.dumps(records, indent=2))
        else:
            for record in records:
                portfolio_print(f"{record['id']} [{record['delivery_state']}] {Path(record['project_path']).name}: {record['message']}")
                if record.get("reason") or record.get("note"):
                    portfolio_print("  " + (record.get("reason") or record["note"]))
            if not records:
                portfolio_print("No requests.")
        return 0
    if args.action == "send":
        source, task_id = decision_owner(args)
        result = store.send_request(source_path=str(source), project_path=task_project(source, task_id),
                                    task_id=task_id, key=args.key, message=args.message)
    elif args.action == "retry":
        result = store.retry_request(args.request_id)
    elif args.action == "cancel":
        result = store.transition_request(args.request_id, "cancel")
    else:
        source, task_id = decision_owner(args)
        result = store.transition_request(args.request_id, args.action, source_path=str(source),
                                          task_id=task_id, session_id=args.session, note=args.note)
    portfolio_print(json.dumps(result, indent=2))
    return 0


def cmd_live(args):
    project = Path(args.dir).expanduser().resolve()
    if args.action == 'attach':
        record = live.attach(project, os.environ.get('CODEX_THREAD_ID'))
    elif args.action == 'poll':
        record = live.poll(project)
    elif args.action == 'seen':
        record = live.poll(project, seen=args.event_ids)
    elif args.action == 'scheduled':
        record = live.poll(project, scheduled=args.job_id)
    else:
        run = runtime.read_json(project / LOCAL / 'run.json')
        record = runtime.read_json(run.get('live_endpoint', project / LOCAL / 'no-live-endpoint'))
    portfolio_print(json.dumps(record, indent=2))
    return 0


def live_instructions(project):
    prefix = shlex.join([sys.executable, str(SCRIPT)])
    return ('\n\n## Live portfolio inbox\n'
            f'Syndicate executable prefix: {prefix}\nSource/workspace: {project}\n'
            f'Inbox skill file: {INBOX_SKILL}\n' + split_frontmatter(INBOX_SKILL.read_text())[1])


def inbox_options(args, config=None):
    settings = {k: CONFIG_DEFAULTS[k] for k in ('inbox-interval', 'inbox-transport')}
    if config is None:
        # Chief of Staff inherits user inbox settings only, never project roles.
        path = user_config_path()
        if path.is_file():
            for raw in path.read_text().splitlines():
                key, sep, value = raw.split('#', 1)[0].partition('=')
                if sep and key.strip() in settings:
                    settings[key.strip()] = value.strip()
    else:
        settings.update({k: config[k] for k in settings})
    interval = getattr(args, 'inbox_interval', None)
    transport = getattr(args, 'inbox_transport', None) or settings['inbox-transport']
    if transport not in ('auto', 'poll', 'channel'):
        raise SyndicateError('inbox-transport must be auto, poll, or channel')
    return dict(interval=live.interval_minutes(settings['inbox-interval'] if interval is None else interval),
                transport=transport)


def cmd_messages(args):
    store = live.MessageStore(REGISTRY_PATH.parent / 'portfolio')
    if args.action == 'list':
        records = store.read()
        if not args.all:
            records = [r for r in records if r['state'] == 'pending']
        portfolio_print(json.dumps(records, indent=2))
    elif args.action == 'acknowledge':
        portfolio_print(json.dumps(store.update(message_id=args.message_id), indent=2))
    else:
        source, task_id = decision_owner(args)
        sessions = coordination_store().snapshot()['sessions']
        owner = next((s for s in sessions if s['id'] == args.session and s['live'] and
                      (s['source_path'], s['task_id']) == (str(source), task_id)), None)
        if not owner:
            raise SyndicateError('Messages must be sent by the owning active task/session')
        if not args.message.strip() or not args.key.strip():
            raise SyndicateError('Provide a nonempty message and key')
        portfolio_print(json.dumps(store.update(source_path=str(source), task_id=task_id,
                         session_id=args.session, key=args.key, message=args.message), indent=2))
    return 0


def commit_closeout(project, task_id, session_id, state, progress, message, *, attention=False,
                    role_participants=None, role_blocker=None):
    """Commit task fields and Chief notification in one messages.json replacement.

    Callers hold coordination.lock and validate ownership there (or are the
    exiting supervisor). Status readers overlay this commit without rewriting
    agent-owned status.json, so concurrent unrelated task writes cannot be lost.
    """
    if not progress.strip() or not message.strip():
        raise SyndicateError('Provide nonempty --progress and --message')
    if state == 'done' and (role_participants is None or not all(role_participants.values())):
        raise SyndicateError('Done requires actual implementation and independent review participants '
                             'via --implementation and --review')
    if role_participants is not None and not live.valid_role_participants(role_participants):
        raise SyndicateError('Provide valid specialist roles, providers, and participant IDs. '
                             'Implementation and review must use distinct roles and participant IDs.')
    if role_blocker is not None and (state != 'blocked' or not live.valid_role_blocker(role_blocker)):
        raise SyndicateError('--role-blocker requires --state blocked and the unavailable role and reason')
    status = read_status(str(project))
    current = (status or {}).get('current') or {}
    task = next((t for t in (status or {}).get('tasks', []) if t.get('id') == task_id), None)
    if (not task or current.get('task_id') != task_id or current.get('session_id') != session_id
            or task.get('session_id') != session_id):
        raise SyndicateError('Closeout must target the current owning task/session')
    stamp = portfolio.now()
    patch = dict(state=state, progress=progress, updated_at=stamp,
                 completed_at=stamp if state in ('done', 'ended') else None,
                 closeout_session=session_id, needs_attention=attention)
    if state == 'ended':
        patch.update(ended_at=stamp, last_state=task.get('state'),
                     end_reason='session exited' if attention else 'closed by owning session')
    if role_participants is not None:
        patch['role_participants'] = role_participants
        for category, entries in role_participants.items():
            if entries:
                people = ', '.join(f"{entry['role']} ({entry['provider']}, {entry['participant_id']})"
                                   for entry in entries)
                message += f"\n{category.capitalize()} performed by {people}."
    if role_blocker is not None:
        patch['role_blocker'] = role_blocker
        blocker = f"Required role {role_blocker['role']} could not start. {role_blocker['reason']}"
        patch['progress'] += f" {blocker}"
        message += f"\n{blocker}"
    record = live.MessageStore(portfolio_dir()).update(
        source_path=str(project), task_id=task_id, session_id=session_id,
        key='session-closeout', message=message, closeout=patch, reuse_for_exit=attention)
    return record


def cmd_tasks_close(args):
    project = Path(args.dir).expanduser().resolve()
    if portfolio.is_chief_record(portfolio_dir(), path=project):
        raise SyndicateError('Task closeout does not apply to Chief sessions')
    store = coordination_store()
    with store.edit(read_only=True) as data:
        owner = next((s for s in data['sessions'] if s['id'] == args.session
                      and (s['source_path'], s['task_id']) == (str(project), args.task_id)), None)
        if not owner or not store.session_live(owner):
            raise SyndicateError('Closeout requires the owning active task/session')
        role_participants = None
        if args.implementation or args.review:
            role_participants = {
                category: [dict(role=role, provider=provider, participant_id=participant_id)
                           for role, provider, participant_id in entries]
                for category, entries in (('implementation', args.implementation or []),
                                          ('review', args.review or []))
            }
        role_blocker = dict(zip(('role', 'reason'), args.role_blocker)) if args.role_blocker else None
        try:
            record = commit_closeout(project, args.task_id, args.session, args.state,
                                     args.progress, args.message, role_participants=role_participants,
                                     role_blocker=role_blocker)
        except OSError as error:
            raise SyndicateError(f'Closeout failed before commit: {error}; retry outside the sandbox with approval') from error
    portfolio_print(json.dumps(record, indent=2))
    return 0


def cmd_tasks_worktree(args):
    """Create or re-adopt the task's durable, locked linked worktree and print its path."""
    source = Path(args.dir).expanduser().resolve()
    repo = Path(args.repo).expanduser().resolve() if args.repo else source
    status_path = source / LOCAL / "status.json"
    if not status_path.is_file():
        raise SyndicateError(
            f"Task worktree not ready: {status_path} does not exist. Pass the task's launch source "
            "(the directory whose .syndicate/status.json tracks the task) with -C, and the repository "
            "checkout with --repo.")
    # Warn rather than refuse: the orchestrator creates the worktree before its
    # first edit, which can precede recording the task in status.json.
    status = runtime.read_json(status_path)
    current = status.get("current") if isinstance(status.get("current"), dict) else {}
    tasks = status.get("tasks") if isinstance(status.get("tasks"), list) else []
    known = {t.get("id") for t in tasks if isinstance(t, dict)}
    known |= {current.get("task_id"), runtime.read_json(source / LOCAL / "run.json").get("task_id")}
    if args.task_id not in known:
        print(f"syndicate: warning: task {args.task_id} is not listed in {status_path}; check -C and the "
              "task ID. The series check at cleanup looks the task up in that status.", file=sys.stderr)
    try:
        entry = syndicate_worktrees.ensure_worktree(source, repo, args.task_id, args.branch,
                                                    series=args.series, base=args.base)
    except syndicate_worktrees.WorktreeError as error:
        raise SyndicateError(f"Task worktree not ready: {error}") from error
    print(json.dumps(entry, indent=2) if args.json else entry["path"])
    return 0


def series_guard(repo, task_id):
    """Refuse cleanup while another task of the worktree's series is unfinished.

    The series spans every registered worktree with the same launch source and
    series name. A Syndicate-locked worktree without a readable registry entry
    fails closed: its series cannot be verified."""
    def check(path):
        try:
            entry = syndicate_worktrees.entry_for_path(path)
            records = syndicate_worktrees.list_worktrees(repo) if path.exists() else []
        except syndicate_worktrees.WorktreeError as error:
            raise syndicate_git.CleanupError(
                f"Task series of {path} cannot be verified: {error}") from error
        if not entry:
            record = next((r for r in records if Path(r.get("worktree", "")).resolve() == path), None)
            if (record or {}).get("locked", "").startswith(syndicate_worktrees.LOCK_PREFIX):
                raise syndicate_git.CleanupError(
                    f"Worktree {path} carries a Syndicate lock but has no entry in "
                    f"{syndicate_worktrees.REGISTRY}, so its task series cannot be verified. Register it "
                    "again with `syndicate tasks worktree TASK_ID -C SOURCE --repo REPO --branch BRANCH "
                    "--series SERIES` (same branch and series), then rerun cleanup")
            return
        source = entry.get("source")
        current = task_id
        if not current and source:
            status_current = (read_status(source) or {}).get("current")
            current = status_current.get("task_id") if isinstance(status_current, dict) else None
        try:
            others = [t for t in syndicate_worktrees.series_task_ids(entry) if t != current]
        except syndicate_worktrees.WorktreeError as error:
            raise syndicate_git.CleanupError(f"Task series of {path} cannot be verified: {error}") from error
        if not others:
            return
        states = {}
        for row in gather_statuses(sweep=False):
            for task in row["tasks"] + row["completed_tasks"] + row.get("ended_tasks", []):
                if task.get("id") in others and task.get("source_path") == source:
                    states[task["id"]] = task.get("state") or "unknown"
        active = [f"{t} ({states.get(t, 'not found')})" for t in others
                  if states.get(t) not in (*DONE_STATES, ENDED)]
        if active:
            raise syndicate_git.CleanupError(
                f"Task series {entry.get('series')} is still active: {', '.join(active)}. "
                f"Worktree {path}, its lock and the task branches were left intact. Finish those tasks, or "
                f"close an abandoned one with `syndicate tasks edit TASK_ID --source {shlex.quote(str(source))} "
                "--state ended`, then rerun cleanup. A task reported as not found has no status record "
                "under that source; confirm with `syndicate tasks list` that it is gone, then remove its ID "
                f"from task_ids in {syndicate_worktrees.REGISTRY}")
    return check


def cmd_tasks_cleanup_pr(args):
    repo = Path(args.dir).expanduser().resolve()
    worktree = Path(args.worktree).expanduser().resolve()
    try:
        merged = syndicate_git.cleanup_pr(repo, args.number, args.branch, worktree,
                                          lambda message: print(message, flush=True),
                                          series_guard=series_guard(repo, args.task),
                                          removal_lock=syndicate_worktrees.registry_lock)
    except syndicate_git.CleanupError as error:
        raise SyndicateError(f"Post-merge cleanup stopped: {error}") from error
    if not merged or worktree.exists():
        return 0
    # Cleanup is complete and the series verified; forget the worktree and its snapshots.
    try:
        syndicate_worktrees.drop_entry(worktree)
    except (syndicate_worktrees.WorktreeError, OSError) as error:
        print(f"Warning: the registry entry for {worktree} was not removed: {error}", file=sys.stderr)
    try:
        for ref, oid in syndicate_worktrees.delete_snapshots(repo, args.branch):
            print(f"Deleted handoff snapshot {ref} ({oid}).", flush=True)
    except syndicate_worktrees.WorktreeError as error:
        print(f"Warning: handoff snapshot refs of {args.branch} were not deleted: {error}", file=sys.stderr)
    return 0


@contextmanager
def project_session(project, provider, outcome=None):
    """Own the current task's coordination session for one supervised run.

    On a normal exit a task the agent left 'running' is closed as 'ended',
    unless the caller marked outcome['handoff'] (the run stopped for a
    resumable handoff), which keeps the task resumable."""
    status = read_status(str(project)) or {}
    task_id = (status.get("current") or {}).get("task_id")
    if not task_id:
        yield None
        return
    store = coordination_store()
    session = store.start_session(str(project), task_id, provider, os.getpid(), delegated_closeout_required=True)
    close = True
    try:
        status["current"]["session_id"] = session["id"]
        for task in status.get("tasks", []):
            if task.get("id") == task_id:
                task.update(provider=provider, session_id=session["id"], delegated_closeout_required=True)
        status.pop("_mtime", None)
        runtime.atomic_json(status_path(project), status)
        yield session
    except Exception:
        close = False  # cmd_run records the launch failure as 'failed'
        raise
    finally:
        store.end_session(session["id"])
        if close and not (outcome or {}).get("handoff"):
            try:
                close_owned_task(project, task_id, session_id=session["id"])
            except (OSError, portfolio.PortfolioError, SyndicateError) as error:
                print(f"syndicate: could not record exit closeout for task {task_id}: {error}",
                      file=sys.stderr)


def close_owned_task(project, task_id, *, session_id=None) -> bool:
    """On supervised exit, close the task this session owned if the agent left it
    'running': state 'ended' (not done), keeping last_state, ended_at and
    end_reason. Other incomplete states and legacy done or blocked reports are preserved.
    Called after the CLI process group has been stopped, so it cannot
    race the agent's own status writes. Never applies to Chief records."""
    if portfolio.is_chief_record(portfolio_dir(), path=project):
        return False
    status = read_status(str(project))
    current = (status or {}).get("current")
    if (not status or not isinstance(current, dict)
            or current.get("task_id") != task_id or status.get("state") != "running"
            or (session_id is not None and current.get("session_id") != session_id)):
        return False
    task = next((t for t in status.get('tasks', []) if isinstance(t, dict) and t.get('id') == task_id), None)
    if (not task or task.get('state') != 'running'
            or (session_id is not None and task.get('session_id') != session_id)):
        return False
    session_id = current.get('session_id') or 'legacy-supervised-exit'
    # Legacy records have no session token; this supervisor owns their exit.
    if not current.get('session_id') or not task.get('session_id'):
        current['session_id'] = session_id
        task['session_id'] = session_id
        status.pop('_mtime', None)
        runtime.atomic_json(status_path(project), status)
    progress = f"{task.get('summary') or task_id}: Session exited without closeout; needs attention. Inspect checkpoint and remaining work."
    record = commit_closeout(project, task_id, session_id, 'ended', progress,
                             f'Task {task_id} needs attention: {progress}', attention=True)
    return bool(record.get('closeout', {}).get('needs_attention'))


def chief_instructions(workspace):
    _, body = split_frontmatter(CHIEF_ROLE.read_text())
    prefix = shlex.join([sys.executable, str(SCRIPT)])
    return (body.strip() + f"\n\n## Launch context\nPortfolio workspace: {workspace}\n"
            f"Portfolio store: {REGISTRY_PATH.parent / 'portfolio'}\n"
            f"Use this exact executable prefix for every Syndicate command: {prefix}\n"
            "This is a portfolio session, not a project orchestrator or specialist.\n" + live_instructions(workspace))


def build_chief_of_staff(provider, workspace, headless, task):
    instructions = chief_instructions(workspace)
    if provider == "claude":
        tools = ['Read', 'Bash'] + ([] if headless else SCHEDULER_TOOLS)
        agent = dict(description="Chief of Staff for cross-project coordination", prompt=instructions,
                     tools=tools)
        settings = {"statusLine": {"type": "command", "command":
                    shlex.join([sys.executable, str(SCRIPT), "_claude-usage"])}}
        argv = ["claude", "--agent", "chief-of-staff", "--agents", json.dumps({"chief-of-staff": agent}),
                "--tools", ','.join(tools), "--settings", json.dumps(settings)]
        if headless:
            argv.append("-p")
    else:
        argv = ["codex"] + (["exec", "--skip-git-repo-check"] if headless else [])
        argv += ["-C", str(workspace), "-s", "workspace-write", "--add-dir", str(REGISTRY_PATH.parent / "portfolio"),
                 "--disable", "multi_agent", "--disable", "multi_agent_v2",
                 "-c", "sandbox_workspace_write.network_access=false",
                 "-c", f"developer_instructions={jstr(instructions)}"]
    return argv + cli_options(provider) + ["--", task]


def cmd_chief_of_staff(args):
    import math
    if not math.isfinite(args.reserve) or not 0 < args.reserve < 100:
        raise SyndicateError("reserve must be between 0 and 100 (exclusive)")
    workspace = REGISTRY_PATH.parent / "portfolio" / "workspace"
    snapshot = None
    snapshot_status = {}
    if args.handoff_path:
        snapshot = Path(args.handoff_path).expanduser().resolve()
        snapshot_status = runtime.read_json(snapshot / "status.json")
        current = snapshot_status.get("current")
        if (not (snapshot / "handoff.md").is_file() or not (snapshot / "checkpoint.md").is_file()
                or not isinstance(current, dict) or current.get("role") != "chief-of-staff"
                or snapshot_status.get("provider") not in CLIS):
            raise SyndicateError("Not a Chief of Staff handoff with a checkpoint and valid status")
    provider = args.runtime or snapshot_status.get("provider") or configured_default_cli() or "claude"
    if provider not in CLIS:
        raise SyndicateError("Chief of Staff runtime must be claude or codex")
    task = args.task or ("Give a concise current cross-project briefing and recommend the next action."
                         if args.print else "Open the Chief of Staff session. Give a brief greeting, refresh portfolio context, then give a concise current briefing. Follow up conversationally about what the requester would like to do next: address pending approvals or prompts, start a new task, or resume existing work. Ground suggestions in verified records and wait for their choice before taking those actions.")
    if snapshot:
        task += (f"\nContinue the Chief of Staff handoff at {snapshot}. Read its handoff.md, checkpoint.md and status.json, "
                 "then reconcile with fresh portfolio records. Preserve unresolved user requests. No project worktree belongs to this session.")
    argv = build_chief_of_staff(provider, workspace, args.print, task)
    inbox = inbox_options(args)
    if provider != 'claude' and inbox['transport'] == 'channel':
        raise SyndicateError('Channel transport requires Claude')
    if args.dry_run:
        print(json.dumps(dict(provider=provider, cwd=str(workspace), argv=argv,
                              inbox=dict(enabled=not args.print and not args.no_live, **inbox)), indent=2))
        return 0
    require_clis({provider})
    with chief_session_lock() as lock:
        workspace.mkdir(parents=True, exist_ok=True, mode=0o700)
        probe_token = runtime.begin_usage_probes()
        try:
            if not args.runtime:
                if snapshot_status.get("provider") in CLIS:
                    preferred = snapshot_status["provider"]
                else:
                    preferred = configured_default_cli()
                chosen = select_launch_cli(preferred, args.reserve, list(CLIS), workspace)
                if chosen and chosen != provider:
                    announce_cli_switch(preferred, chosen, args.reserve)
                    provider = chosen
                    argv = build_chief_of_staff(provider, workspace, args.print, task)
                    if provider != "claude" and inbox["transport"] == "channel":
                        raise SyndicateError("Channel transport requires Claude")
                    require_clis({provider})
            local = workspace / LOCAL
            local.mkdir(parents=True, exist_ok=True, mode=0o700)
            status_file = local / "status.json"
            previous = runtime.read_json(status_file)
            session_id = uuid.uuid4().hex
            history = previous.get("history") if isinstance(previous.get("history"), list) else []
            status = dict(pid=os.getpid(), provider=provider, state="running", session_id=session_id,
                          current=dict(role="chief-of-staff", round=None, summary=task),
                          history=history[-200:])
            runtime.atomic_json(status_file, status)
            checkpoint = local / "checkpoint.md"
            if not checkpoint.exists():
                checkpoint.write_text("Chief of Staff session. Read fresh portfolio records; no prior coordination checkpoint is available.\n")
            try:
                runtime.start_monitor(SCRIPT)
                print(f"syndicate: Chief of Staff on {provider}; monitoring at {args.reserve:g}% reserve.", file=sys.stderr)
                # Keep ownership if the supervisor crashes but its CLI survives.
                result, handoff = runtime.supervise(argv, workspace, {provider}, args.reserve, task, provider,
                                                    headless=args.print, chief=True,
                                                    pass_fds=(lock.fileno(),),
                                                    live=None if getattr(args, 'no_live', False) else dict(directory=workspace.parent, chief=True, **inbox))
                final = runtime.read_json(status_file) or status
                if not isinstance(final.get("current"), dict):
                    final["current"] = dict(status["current"])
                final["current"]["role"] = "chief-of-staff"
                if handoff is not None:
                    final["state"] = "waiting_on_user"
                    runtime.atomic_json(status_file, final)
                    print(f"Chief of Staff stopped. Handoff saved: {handoff}")
                    print("Resume with 'syndicate chief-of-staff --handoff PATH'; use -x only when choosing a provider.")
                    report_usage_reserve(args, workspace, handoff)
                    return 75
                if result != 0:
                    final["state"] = "failed"
                elif final.get("state") == "running":
                    final["state"] = "done"
                runtime.atomic_json(status_file, final)
                return result
            except BaseException:
                final = runtime.read_json(status_file) or status
                final["state"] = "failed"
                runtime.atomic_json(status_file, final)
                raise
        finally:
            runtime.end_usage_probes(probe_token)


def decision_owner(args):
    source = Path(args.dir).expanduser().resolve()
    root = git(source, "rev-parse", "--show-toplevel")
    source = Path(root).resolve() if root else source
    status = read_status(str(source)) or {}
    task_id = args.task or (status.get("current") or {}).get("task_id")
    task = next((t for t in project_tasks(status) if t.get("id") == task_id), None)
    if task is None:
        raise SyndicateError("Owning task not found; supply -C and --task for its source status file")
    return source, task_id


def portfolio_print(text):
    # Human-facing records can contain text supplied by a project or requester.
    print(re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]", " ", str(text)))


def cmd_decisions(args):
    store = decision_store()
    if args.action == "list":
        records = store.read()
        if not args.all:
            records = portfolio.pending(records)
        if args.project:
            target = str(resolve_project(args.project))
            records = [d for d in records if d["project_path"] == target]
        if args.json:
            portfolio_print(json.dumps(records, indent=2))
        else:
            for d in records:
                portfolio_print(f"{d['id']} [{d['state']}] {Path(d['project_path']).name}: {d['question']}")
                for field in ("context", "recommendation", "deadline"):
                    if d.get(field):
                        portfolio_print(f"  {field.title()}: {d[field]}")
                if d.get("options"):
                    portfolio_print("  Options: " + " | ".join(d["options"]))
                if d.get("blocking"):
                    portfolio_print("  Blocks work")
                if d.get("answer"):
                    portfolio_print(f"  Answer revision: {d['answer_revision']}")
                    portfolio_print(f"  Answer (awaiting acknowledgment): {d['answer']}" if d['state'] == 'answered'
                          else f"  Answer: {d['answer']}")
            if not records:
                portfolio_print("No decisions.")
        return 0
    if args.action == "request":
        source, task_id = decision_owner(args)
        target = source
        # Respect dashboard assignments without changing the task's source identity.
        for row in gather_statuses():
            if any(t.get("id") == task_id and t.get("source_path") == str(source)
                   for t in row["tasks"] + row["completed_tasks"] + row.get("ended_tasks", [])):
                target = Path(row["path"])
        result = store.request(source_path=str(source), project_path=str(target), task_id=task_id,
                               key=args.key, question=args.question, context=args.context,
                               options=args.option, recommendation=args.recommendation,
                               blocking=args.blocking, deadline=args.deadline)
    elif args.action == "acknowledge":
        source, task_id = decision_owner(args)
        result = store.transition(args.decision_id, args.action, source_path=str(source), task_id=task_id,
                                  answer_revision=args.answer_revision)
    else:
        result = store.transition(args.decision_id, args.action, answer=getattr(args, "answer", None))
    portfolio_print(json.dumps(result, indent=2))
    return 0


def cmd_briefing(args):
    data = project_briefing()
    if args.json:
        portfolio_print(json.dumps(data, indent=2))
        return 0
    portfolio_print("CHIEF OF STAFF / BRIEFING\n")
    chief = data['chief']
    portfolio_print(f"Chief: {chief['state']} / {chief['provider']} / saved report: {chief['report_state']}")
    if chief.get('reason'):
        portfolio_print(chief['reason'])
    portfolio_print(f"Saved checkpoint ({chief['checkpoint']['updated_at'] or 'unavailable'}):")
    portfolio_print(chief['checkpoint']['summary'] or 'Checkpoint unavailable or empty.')
    portfolio_print(data["next_action"] + "\n")
    for project in data["projects"]:
        portfolio_print(f"{project['name']} [{project['status']}] / {project['provider']} / report: {project['report_state']}")
        portfolio_print(f"  {project['progress'] or project['task'] or 'No task reported'}")
        portfolio_print(f"  Updated: {project['updated_at'] or 'unknown'}")
        if project.get("brief"):
            brief = project["brief"]
            portfolio_print(f"  Goal: {brief['goal']} / priority: {brief['priority'] or 'unset'} / revision: {brief['revision']}")
            for field in portfolio.BRIEF_LIST_FIELDS:
                for value in brief[field]:
                    portfolio_print(f"  {field.replace('_', ' ').title()}: {value}")
        for session in project.get("sessions", [])[-1:]:
            portfolio_print(f"  Session: {session['id']} / {session_label(session)}")
    portfolio_print("\nDECISION INBOX")
    for decision in data["decisions"]:
        portfolio_print(f"{decision['id']} [{decision['state']}] {Path(decision['project_path']).name}: {decision['question']}")
        for field in ("context", "recommendation", "answer"):
            if decision.get(field):
                portfolio_print(f"  {field.title()}: {decision[field]}")
    if not data["decisions"]:
        portfolio_print("No pending decisions.")
    portfolio_print("\nTEAM REQUESTS")
    for request in data["requests"]:
        portfolio_print(f"{request['id']} [{request['delivery_state']}] {Path(request['project_path']).name}: {request['message']}")
        if request.get("reason"):
            portfolio_print("  " + request["reason"])
    if not data["requests"]:
        portfolio_print("No pending or failed requests.")
    return 0


def dashboard_color(mode: str = "auto") -> bool:
    return mode == "always" or (mode == "auto" and sys.stdout.isatty()
                               and "NO_COLOR" not in os.environ
                               and os.environ.get("TERM") != "dumb")


def render_dashboard(rows: list[dict], *, width: int = 100, color: bool = False,
                     details: bool = False, decisions: list[dict] | None = None,
                     coordination: dict | None = None, chief: dict | None = None) -> str:
    import textwrap
    width = max(24, width)

    def clean(value):
        # Task text must not inject terminal escape sequences or extra rows.
        return re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", str(value or ""))

    def paint(text, code):
        return f"\x1b[{code}m{text}\x1b[0m" if color else text

    def wrapped(text, indent=""):
        return textwrap.wrap(clean(text), width=width, initial_indent=indent,
                             subsequent_indent=indent) or [indent]

    styles = {"Needs attention": ("!", "33"), "Working": (">", "36"),
              "Queued": ("~", "35"), "Complete": ("+", "32"), "No tasks": ("-", "90")}

    def status(row):
        return row.get("project_status") or {"running": "Working", "done": "Complete",
                "queued": "Queued"}.get(row.get("state"), "Needs attention")

    def current(row):
        return portfolio.current_task(row, coordination.get("sessions", []) if coordination else [])

    lines = [paint("SYNDICATE / PROJECTS", "1"), *wrapped(now_iso()), ""]
    if chief is not None:
        lines.append(paint("CHIEF OF STAFF / " + clean(chief['state']), "1"))
        lines.extend(wrapped(f"Provider: {chief['provider']} / saved report: {chief['report_state']}"))
        if chief.get('reason'):
            lines.extend(wrapped(chief['reason']))
        checkpoint = chief['checkpoint']
        lines.extend(wrapped(f"Saved checkpoint: {checkpoint['updated_at'] or 'unavailable'}"))
        lines.extend(wrapped(checkpoint['summary'] or f"Checkpoint {checkpoint['state']}."))
        if checkpoint['truncated']:
            lines.extend(wrapped("Checkpoint excerpt truncated."))
        if details:
            lines.extend(wrapped(f"Session: {chief.get('session_id') or 'unknown'} / status saved: {chief.get('status_updated_at') or 'unknown'}"))
            if chief.get('summary'):
                lines.extend(wrapped("Saved progress: " + chief['summary']))
        lines.append("")
    coordination = coordination or dict(briefs={}, sessions=[], requests=[])
    inbox = portfolio.pending(decisions or [])
    if inbox:
        lines.append(paint("DECISION INBOX", "1;33"))
        for decision in inbox:
            owner = Path(decision["project_path"]).name
            state = "answer needed" if decision["state"] == "open" else "awaiting team acknowledgment"
            lines.extend(wrapped(f"{owner} / {state}"))
            lines.extend(wrapped(f"{decision['id']}: {decision['question']}", "  "))
            if details:
                if decision.get("options"):
                    lines.extend(wrapped("Options: " + " | ".join(decision["options"]), "  "))
                for field in ("context", "recommendation", "answer", "deadline"):
                    if decision.get(field):
                        lines.extend(wrapped(f"{field.title()}: {decision[field]}", "  "))
        lines.append("")
    requests = [r for r in coordination["requests"] if r["state"] in ("queued", "failed")]
    if requests:
        lines.append(paint("TEAM REQUESTS", "1;36"))
        for request in requests:
            lines.extend(wrapped(f"{Path(request['project_path']).name} / {request['delivery_state']}"))
            lines.extend(wrapped(f"{request['id']}: {request['message']}", "  "))
            if request.get("reason") or request.get("note"):
                lines.extend(wrapped(request.get("reason") or request["note"], "  "))
        lines.append("")
    if not rows:
        lines.extend(wrapped("no registered projects — run 'syndicate team init' (or any run) in a project first"))
        return "\n".join(lines)
    counts = [f"{sum(status(r) == label for r in rows)} {label.lower()}" for label in styles]
    lines.extend(wrapped(f"{len(rows)} projects | " + " | ".join(counts)))
    lines.append("")
    # Keep the overview compact; --details adds full paths and task text.
    compact = width < 70
    sizes = [max(5, width - 26), 17, 3] if compact else [min(24, max(12, width // 5)), 17, 5]
    if not compact:
        sizes.append(width - sum(sizes) - 9)

    def table_row(cells, style=None):
        parts = []
        for i, (cell, size) in enumerate(zip(cells, sizes)):
            text = clean(cell)
            text = text if len(text) <= size else text[:size - 1] + "…"
            text = text.ljust(size)
            parts.append(paint(text, style) if i == 1 and style else text)
        return " | ".join(parts)

    if width >= 32:
        lines.append(paint(table_row(["PROJECT", "STATUS", "OPEN"] + ([] if compact else ["CURRENT / LATEST TASK"])), "1"))
        lines.append("-+-".join("-" * size for size in sizes))
        for row in rows:
            label = status(row)
            icon, code = styles[label]
            cells = [row["name"], f"{icon} {label}", str(row.get("unfinished_count", len(row.get("tasks", []))))]
            if not compact:
                cells.append(current(row).get("summary") or "No tasks reported")
            lines.append(table_row(cells, code))
        lines.append("")
    if width < 32 and not details:
        for row in rows:
            icon, code = styles[status(row)]
            lines.extend(paint(line, code) for line in wrapped(f"{icon} {row['name']} / {status(row)}"))
        lines.append("")
    if details:
        for row in rows:
            label = status(row)
            icon, code = styles[label]
            lines.extend(paint(line, "1;" + code) for line in wrapped(f"{icon} {row['name']} / {label}"))
            if row.get("path"):
                lines.extend(paint(line, "90") for line in wrapped(row["path"], "  "))
            brief = coordination["briefs"].get(row.get("path"))
            if brief:
                lines.extend(wrapped(f"Goal: {brief['goal']} / priority: {brief['priority'] or 'unset'} / revision: {brief['revision']}", "  "))
                for field in portfolio.BRIEF_LIST_FIELDS:
                    for value in brief[field]:
                        lines.extend(wrapped(f"{field.replace('_', ' ').title()}: {value}", "  "))
            for session in coordination["sessions"]:
                if session["source_path"] == row.get("path"):
                    lines.extend(wrapped(f"Session: {session['id']} / {session_label(session)} / {session['provider']}", "  "))
            report = current(row)
            lines.extend(wrapped(f"Provider: {report.get('provider') or 'unknown'} / report: {report.get('state') or row.get('state', 'unknown')} / updated: {report.get('updated_at') or row.get('updated_at') or 'unknown'}", "  "))
            tasks = row.get("tasks") or ([current(row)] if current(row) else [])
            for task in tasks:
                prefix = "Last completed" if not row.get("tasks") and row.get("last_completed") else task.get("state", "Current")
                if task.get("liveness") == "unknown":
                    prefix += " (unverified)"
                lines.extend(wrapped(f"{prefix}: {task.get('summary') or 'No task details reported'}", "  "))
                if task.get("progress") and task["progress"] != task.get("summary"):
                    lines.extend(wrapped(task["progress"], "    "))
                role = task.get("role")
                if role:
                    lines.extend(wrapped(", ".join(role) if isinstance(role, list) else role, "    "))
            if not tasks:
                lines.extend(wrapped("No tasks reported", "  "))
            ended = row.get("ended_tasks") or []
            if ended:
                lines.extend(wrapped(f"Ended without completion: {len(ended)} (latest: {ended[0].get('summary') or 'untitled'}"
                                     f" / {ended[0].get('end_reason') or 'session ended'})", "  "))
            lines.append("")
    lines.extend(wrapped("! needs attention   > working   ~ queued   + complete   - no tasks"))
    return "\n".join(lines)


@contextmanager
def dashboard_keyboard(enabled: bool):
    """Read single keys while live, restoring terminal settings on every exit."""
    if not enabled or not sys.stdin.isatty():
        yield None
        return
    import termios
    import tty
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        yield fd
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, previous)


def dashboard_wait(interval: float, keyboard: int | None) -> bool:
    """Return True when the user asks to quit, without waiting for a refresh."""
    if keyboard is None:
        time.sleep(interval)
        return False
    import select
    deadline = time.monotonic() + interval
    while True:
        ready, _, _ = select.select([keyboard], [], [], max(0, deadline - time.monotonic()))
        if not ready:
            return False
        key = os.read(keyboard, 1)
        if key in (b"q", b"Q", b""):
            return True
        if time.monotonic() >= deadline:
            return False


def cmd_dashboard(args: argparse.Namespace) -> int:
    try:
        with dashboard_keyboard(not args.once and not args.list and sys.stdout.isatty()) as keyboard:
            while True:
                rows = gather_statuses()
                if args.project:
                    selected = REGISTRY_PATH.parent / "generic-tasks" if args.project == "generic" else Path(args.project).expanduser().resolve()
                    rows = [r for r in rows if r["name"] == args.project or r["path"] == str(selected)]
                decisions = [] if args.list else decision_store().read()
                coordination = dict(briefs={}, sessions=[], requests=[]) if args.list else coordination_store().snapshot(strict=False)
                if args.project:
                    paths = {row["path"] for row in rows}
                    decisions = [d for d in decisions if d["project_path"] in paths]
                    coordination["requests"] = [r for r in coordination["requests"] if r["project_path"] in paths]
                if not args.once and not args.list and sys.stdout.isatty() and os.environ.get("TERM") != "dumb":
                    print("\x1b[2J\x1b[H", end="")  # clear screen, home cursor
                print("\n".join(f"{r['name']}  {r['path']}" for r in rows) if args.list else render_dashboard(
                    rows, width=shutil.get_terminal_size((100, 24)).columns,
                    color=dashboard_color(getattr(args, "color", "auto")),
                    details=getattr(args, "details", False), decisions=decisions, coordination=coordination,
                    chief=portfolio.chief_status(REGISTRY_PATH.parent / "portfolio")))
                if args.once or args.list:
                    return 0
                if keyboard is not None:
                    print("\nq quit · Ctrl-C quit", flush=True)
                if dashboard_wait(args.interval, keyboard):
                    return 0
    except KeyboardInterrupt:
        return 0


class _DashboardHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *a):  # keep stdout quiet
        pass

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._serve_file(WEB_DIR / "dashboard.html", "text/html; charset=utf-8")
        elif self.path == "/api/limits":
            runtime.start_monitor(SCRIPT)
            body = json.dumps({"summary": runtime.describe_limits(),
                               "monitor": runtime.read_json(runtime.STATE / "monitor.json")}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/briefing":
            try:
                body = json.dumps(project_briefing(sweep=False)).encode()  # GET never writes
                code = 200
            except portfolio.PortfolioError as error:
                body = json.dumps({"error": str(error)}).encode()
                code = 503
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/status":
            body = json.dumps(gather_statuses(sweep=False)).encode()  # GET never writes
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()

    def _serve_file(self, path: Path, content_type: str) -> None:
        if not path.is_file():
            self.send_response(404)
            self.end_headers()
            return
        body = path.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def cmd_web(args: argparse.Namespace) -> int:
    server = http.server.HTTPServer(("127.0.0.1", args.port), _DashboardHandler)
    runtime.start_monitor(SCRIPT)
    print(f"syndicate web dashboard: http://127.0.0.1:{server.server_address[1]}/  (ctrl-c to stop)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    # A project lock covers the entire confirmation/switch cycle, preventing
    # another orchestrator from racing snapshots or changing the worktree.
    import fcntl
    directory = Path(args.dir).expanduser().resolve()
    explicit = getattr(args, "project", None)
    target = execution_project(explicit) if explicit else None
    if target:
        directory = target
    project = register_workspace(directory)
    args.dir = str(project)
    args.project_path = str(target) if target else None
    (project / LOCAL).mkdir(parents=True, exist_ok=True)
    reconcile_stale()
    lock_path = project_lock_path(project)
    try:
        lock_fd, lock_info = portfolio.open_lock(lock_path, create=True)
    except portfolio.UnsafeLockError as error:
        raise SyndicateError(f"refusing unsafe project lock: {error}; remove it and launch again") from None
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR, errno.EMLINK):
            raise SyndicateError(f"refusing project lock {lock_path}: it or {LOCAL}/ is a symbolic link "
                                 "or not a directory; remove it and launch again") from None
        raise SyndicateError(f"cannot open project lock {lock_path}: {error.strerror or error}") from None
    try:
        for attempt in range(LOCK_ATTEMPTS):
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                # A dashboard's momentary shared probe must not fail a launch.
                if attempt == LOCK_ATTEMPTS - 1:
                    raise SyndicateError(
                        f"another Syndicate orchestrator already owns this project: {lock_path} is locked. "
                        "If no orchestrator is running, a leftover process may still hold it; identify it with "
                        f"'fuser -v {shlex.quote(str(lock_path))}' or 'lsof {shlex.quote(str(lock_path))}'") from None
                time.sleep(0.05)
        # The lock is close-on-exec and never passed to the CLI: only this
        # launcher (or its supervisor) holds it. The supervised CLI child is
        # recorded as an additional owner instead (cli_owner).
        args.session_lock_fd = lock_fd
        owner = {**owner_identity(os.getpid()), "lock_owned": True,
                 "lock_inode": [lock_info.st_dev, lock_info.st_ino], "cli_owner": None}
        sessions = [session for session in coordination_store().snapshot()["sessions"]
                    if session["source_path"] == str(project)]
        if any(session["live"] for session in sessions):
            raise SyndicateError("another active session already owns this project")
        prior = read_status(str(project)) or {}
        # Without lock inheritance, a CLI whose supervisor crashed is found by identity.
        # Only the launcher-written coordination copy can refuse a launch: the
        # status copy is agent-writable and could name any live process.
        orphan = next((child for child in cli_owners(*[s for s in sessions if s["state"] == "active"])
                       if portfolio.record_liveness(child) == "alive"), None)
        if orphan:
            pid = orphan.get("pid")
            raise SyndicateError(f"a CLI from an earlier launch (PID {pid}) may still run in this project; "
                                 f"inspect it with 'ps -o pid,args -p {pid}' and 'ls -l /proc/{pid}/cwd' "
                                 "before launching again")
        resume = getattr(args, "handoff_path", None)
        snapshot = runtime.read_json(Path(resume) / "status.json") if resume else {}
        existing_id = (prior.get("current") or {}).get("task_id")
        snapshot_id = (snapshot.get("current") or {}).get("task_id")
        if not (resume and existing_id and existing_id == snapshot_id):
            write_status_stub(project, os.getpid(), args.rest[0] if args.rest else "(interactive session)")
            status = read_status(str(project))
            task = status["tasks"][-1]
            task["project_path"] = getattr(args, "project_path", None)
            task["needs_project"] = not explicit and not git(project, "rev-parse", "--show-toplevel")
        else:
            status = prior
            status.update(state="running")
            status["current"].pop("session_id", None)
        status.update(owner)
        for task in status.get("tasks") if isinstance(status.get("tasks"), list) else []:
            if isinstance(task, dict) and task.get("id") == (status.get("current") or {}).get("task_id"):
                task.update(owner, state="running")
                for key in ("session_id", "closeout_session", "completed_at", "needs_attention",
                            "role_participants", "role_blocker",
                            "ended_at", "end_reason", "last_state"):
                    task.pop(key, None)  # a resumed task is running again, not ended
        status.pop("_mtime", None)
        runtime.atomic_json(status_path(project), status)
        while True:
            try:
                result = run_session(args)
            except Exception as error:
                current_closeouts = set()
                status = read_status(str(project), current_closeouts=current_closeouts) or {}
                if current_closeouts:
                    raise
                current = status.setdefault("current", {})
                status.update(state="failed")
                current["summary"] = f"Launch failed: {error}"
                status.pop("_mtime", None)
                runtime.atomic_json(status_path(project), status)
                raise
            if result is not None:
                return result
    finally:
        os.close(lock_fd)


def record_cli_owner(project, session, pid) -> None:
    """Record the supervised CLI child on the status, its current task, and the
    coordination session. Either copy is enough to stop a released lock from
    being read as proof that the session ended."""
    owner = owner_identity(pid)
    stored = False
    if session:
        try:
            coordination_store().record_cli_owner(session["id"], owner)
            stored = True
        except (portfolio.PortfolioError, OSError) as error:
            print(f"syndicate: could not record CLI owner in coordination state: {error}", file=sys.stderr)
    status = read_status(str(project))
    if not status:
        return
    task_id = (status.get("current") or {}).get("task_id")
    tasks = [task for task in (status.get("tasks") if isinstance(status.get("tasks"), list) else [])
             if isinstance(task, dict) and task.get("id") == task_id]
    status["cli_owner"] = owner
    for task in tasks:
        task["cli_owner"] = owner
    status.pop("_mtime", None)
    try:
        runtime.atomic_json(status_path(project), status)
        return
    except OSError as error:
        print(f"syndicate: could not record CLI owner in status: {error}", file=sys.stderr)
    if stored:
        return
    # Neither copy names the live child, so a later free lock would not prove
    # the session ended: best-effort withdraw the lock as ownership evidence.
    status["cli_owner"] = None
    status["lock_owned"] = False
    for task in tasks:
        task.update(cli_owner=None, lock_owned=False)
    try:
        runtime.atomic_json(status_path(project), status)
    except OSError:
        pass  # liveness then rests on the launcher's PID and start identity


def run_session(args: argparse.Namespace) -> int | None:
    token = runtime.begin_usage_probes()
    try:
        return _launch_session(args)
    finally:
        runtime.end_usage_probes(token)


def _launch_session(args: argparse.Namespace) -> int | None:
    project = Path(args.dir).resolve()
    team = resolve_team(project, args.runtime)
    inbox = inbox_options(args, team.config)
    if getattr(args, "all_runtime", None):
        for role in team.roles.values():
            role.cli = args.all_runtime
        team.roles["orchestrator"].cli = team.host
        team.pin_runtimes = True
    reserve = getattr(args, "reserve", None)
    reserve = float(team.config["handoff-reserve"]) if reserve is None else reserve
    if not 0 < reserve < 100:
        raise SyndicateError("reserve must be between 0 and 100 (exclusive)")
    if not args.runtime and team.config["handoff"] == "on":
        preferred = configured_cli(team, "orchestrator")
        chosen = select_launch_cli(preferred, reserve, list(CLIS), project)
        if chosen and chosen != team.host:
            announce_cli_switch(preferred, chosen, reserve)
            team.host = chosen
            team.roles["orchestrator"].cli = team.host
    if team.host != 'claude' and inbox['transport'] == 'channel':
        raise SyndicateError('Channel transport requires Claude')
    if getattr(args, "handoff_path", None):
        path = Path(args.handoff_path).resolve()
        if not (path / "handoff.md").is_file():
            raise SyndicateError(f"no handoff.md in {path}")
        args.rest = [f"Continue the interrupted work from {path / 'handoff.md'}. Read its checkpoint and status, verify the live worktree, then complete outstanding work, testing, and review."]
    for w in team.warnings:
        print(f"syndicate: {w}", file=sys.stderr)
    require_clis({r.cli for r in team.roles.values()})
    outcome = {}
    exec_cli = team.config["handoff"] == "off"
    with project_session(project, team.host, outcome) as session:
        status = read_status(str(project)) or {}
        if status:
            # exec keeps this PID and start time, so the recorded identity covers
            # the CLI; the lock closes at exec and proves nothing there.
            status.update(state="running", pid=os.getpid(), lock_owned=not exec_cli and status.get("lock_owned") is True)
            task_id = (status.get("current") or {}).get("task_id")
            for task in status.get("tasks", []):
                if task.get("id") == task_id:
                    task.update(provider=team.host, lock_owned=status["lock_owned"])
            status.pop("_mtime", None)
            runtime.atomic_json(status_path(project), status)
        note = ensure_excluded(project)
        if note:
            print(f"syndicate: {note}", file=sys.stderr)
        build = build_claude if team.host == "claude" else build_codex
        argv = build(team, args.print, args.rest)
        if team.host == "claude" and args.print:
            # Headless Claude gives up on still-running subagents after 600s; a team run is longer.
            os.environ.setdefault("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS", "0")
        task = args.rest[0] if args.rest else "Interactive session; see checkpoint and session output for requests."
        task_owner = (session["task_id"], session["id"]) if session else None
        if exec_cli:
            run_id = runtime.write_run_record(project, task, team.host, None, task_owner)
            os.chdir(project)
            os.execvpe(argv[0], argv, {**os.environ, runtime.RUN_ENV: run_id})
        runtime.start_monitor(SCRIPT)
        # The host is enforced for the whole run. Each specialist runner
        # enforces its own usage reserve so it can retry without stopping the host.
        providers = {team.host}
        print(f"syndicate: monitoring {team.host} account limits; handoff at {reserve:g}% remaining, "
              "judged by the latest recorded reading. Delegated specialists check usage at launch "
              "and while they run.", file=sys.stderr)
        # The supervisor alone holds session.lock; the CLI child is recorded as an
        # additional owner so a supervisor crash is not mistaken for the end.
        result, handoff = runtime.supervise(argv, project, providers, reserve, task, team.host, headless=args.print,
                                           on_start=lambda pid: record_cli_owner(project, session, pid),
                                           task_owner=task_owner,
                                           live=None if getattr(args, 'no_live', False) else dict(directory=REGISTRY_PATH.parent / 'portfolio', **inbox))
        if handoff is None:
            return result
        outcome["handoff"] = True  # resumable: never close the task as ended
        print(f"\nHandoff: {handoff}")
        target = runtime.choose_target(team.host, not args.print and sys.stdin.isatty(),
                                       limited=runtime.limited_provider(project, handoff))
        if target is None:
            report_usage_reserve(args, project, handoff)
            return 75  # resumable temporary interruption; not successful completion
        require_clis({target})
        # A non-current reading at or below the reserve is checked once, for this
        # target only. An expected reset is not treated as restored capacity.
        _observation, remaining, refreshed = runtime.confirm_capacity(target, reserve, cwd=project)
        if remaining is not None and remaining <= reserve:
            if refreshed:
                detail = (f"{target} still has only {remaining:g}% remaining after a fresh usage check "
                          f"(reserve {reserve:g}%); leaving work stopped. {runtime.forget_hint(target)}")
            else:
                detail = (f"{target} last recorded only {remaining:g}% remaining (reserve {reserve:g}%); "
                          "leaving work stopped. A passed reset time does not count as restored capacity; "
                          f"{runtime.forget_hint(target)}")
            report_usage_reserve(args, project, handoff, detail)
            return 75
        args.runtime = target
        args.all_runtime = target
        args.handoff_path = str(handoff)
        return None  # cmd_run retains the project lock while starting the confirmed target


def specialist_gate(role: Role, reserve: float | None, cwd=None) -> None:
    """Refuse to launch a specialist whose provider is at or below the reserve.

    A reading that is not current and is at or below the reserve is refreshed
    once, for this provider only, before the refusal. A current reading is
    used as recorded. No reading at all fails loudly: the runner could not
    enforce the reserve for this provider. No gate applies with handoff = off.
    """
    if reserve is None:
        return
    provider = role.cli
    observation, remaining, refreshed = runtime.confirm_capacity(provider, reserve, cwd=cwd)
    refused = f"refusing to launch the {role.name} specialist on {provider}; no {provider} CLI was launched. "
    move = (f"move this role to another runtime ('{role.name} = {'codex' if provider == 'claude' else 'claude'}' "
            "in .syndicate/syndicate.conf, or relaunch the team with --all-runtime)")
    if remaining is None:
        if provider == "claude":
            guidance = ("Run an interactive Claude session through Syndicate to publish usage, check "
                        f"'syndicate limits', or {move}.")
        else:
            error = runtime.read_json(runtime.STATE / "monitor.json").get("codex_error")
            guidance = ((f"The account monitor reports: {error}. " if error else "") +
                        f"Check 'syndicate limits' (it starts the account monitor), or {move}.")
        raise SyndicateError(refused + f"No {provider} usage reading has been recorded, so the "
                             f"{reserve:g}% reserve cannot be enforced. " + guidance)
    when = runtime.format_time(runtime.observed_time(observation), missing="at an unknown time")
    if remaining <= reserve:
        if refreshed:
            basis = (f"A fresh {provider} reading shows {remaining:g}% account usage remaining, "
                     f"at or below the {reserve:g}% reserve. Check 'syndicate limits', or {move}. ")
        else:
            basis = (f"The last {provider} reading (observed {when}) shows {remaining:g}% "
                     f"account usage remaining, at or below the {reserve:g}% reserve. A passed reset "
                     f"time does not count as restored capacity; check 'syndicate limits', or {move}. ")
        raise SpecialistReserveReached(refused + basis + f"Recovery: {runtime.forget_hint(provider)}.", 1)
    state, _ = runtime.availability(observation)
    if state != "current":
        print(f"syndicate: WARNING: {provider} usage telemetry is {state}; launching {role.name} on the last "
              f"reading (observed {when}, {remaining:g}% remaining).", file=sys.stderr)


def role_task_owner(project):
    """Identify the current task/session before a specialist attempt starts."""
    inherited_run = os.environ.get(runtime.RUN_ENV)
    if not runtime.valid_run_id(inherited_run):
        return None
    status = runtime.read_json(status_path(project))
    current = status.get("current")
    if isinstance(current, dict):
        task_id, session_id = current.get("task_id"), current.get("session_id")
        if all(isinstance(value, str) and value for value in (task_id, session_id)):
            state, record = read_run_record(project)
            if state == "valid" and (record["id"], record.get("task_id"), record.get("session_id")) == (
                    inherited_run, task_id, session_id):
                return task_id, session_id
    return None


def hold_role_task(project, owner, role, providers):
    """Park the owning task without rewriting the orchestrator's status file."""
    if owner is None or portfolio.is_chief_record(portfolio_dir(), path=project):
        return False
    task_id, session_id = owner
    store = coordination_store()
    with store.edit(read_only=True) as data:
        status = read_status(str(project)) or {}
        current = status.get("current") or {}
        if (current.get("task_id"), current.get("session_id")) != owner:
            return False
        if status.get("state") != "running":
            return status.get("state") == "on_hold"
        session = next((s for s in data["sessions"] if s["id"] == session_id
                        and (s["source_path"], s["task_id"]) == (str(project), task_id)), None)
        if not session or not store.session_live(session):
            return False
        progress = f"Task on hold. {role.name} could not run because the usage limit or reserve was reached on {', '.join(providers)}."
        commit_closeout(project, task_id, session_id, "on_hold", progress, progress)
    return True


def cmd_run_role(args: argparse.Namespace) -> int:
    # A specialist is part of an existing project, not a new owner. Registry
    # registration requires a host-only lock and is unnecessary here.
    project = execution_project(args.dir)
    team = resolve_team(project)
    role = team.roles.get(args.role)
    if not role or args.role == "orchestrator":
        raise SyndicateError(f"unknown role '{args.role}'")
    if getattr(args, "runtime", None):
        role.cli = args.runtime
    brief = sys.stdin.read() if args.brief == "-" else args.brief
    owner = role_task_owner(project)
    failed_provider = getattr(args, "backoff_from", None)
    if failed_provider and getattr(args, "runtime", None):
        raise SyndicateError("--runtime and --backoff-from cannot be combined")
    providers = {cli for cli in CLIS if shutil.which(cli)}
    launch_reserve = float(team.config["handoff-reserve"]) if team.config["handoff"] == "on" else None
    run_reserve = specialist_run_reserve(project, launch_reserve)
    reserve = max(launch_reserve or 0, run_reserve or 0)
    exhausted = set()
    if failed_provider:
        exhausted.add(failed_provider)
        providers.add(failed_provider)
        failure = runtime.RoleUsageLimit(f"{failed_provider} reported a usage limit for {role.name}")
    else:
        require_clis({role.cli})
        providers.add(role.cli)
        failure = None
    provider = role.cli
    token = runtime.begin_usage_probes()
    try:
        return _launch_role(args, project, team, role, brief, owner, providers, launch_reserve, reserve,
                            run_reserve, exhausted, failure, provider)
    finally:
        runtime.end_usage_probes(token)


def _launch_role(args, project, team, role, brief, owner, providers, launch_reserve, reserve,
                 run_reserve, exhausted, failure, provider):
    if (not getattr(args, "runtime", None) and launch_reserve is not None and not exhausted):
        preferred = configured_cli(team, role.name)
        candidates = list(CLIS)
        # A Codex read-only role cannot move onto Claude. Claude may still move onto Codex.
        if not role.can_write and preferred == "codex":
            candidates = ["codex"]
        chosen = select_launch_cli(preferred, reserve, candidates, project)
        if chosen and chosen != role.cli:
            announce_cli_switch(preferred, chosen, reserve)
            role.cli = chosen
            provider = chosen
            providers.add(chosen)
            require_clis({chosen})
    while True:
        if failure is not None:
            for cli in sorted(providers):
                if cli in exhausted:
                    continue
                if not role.can_write and cli == "claude" and "codex" in exhausted:
                    continue
                runtime.ensure_reading(cli, cwd=project, threshold=reserve)
            readings = {cli: runtime.recorded_remaining(cli, reserve) for cli in sorted(providers)}
            untried = {cli: remaining for cli, remaining in readings.items() if cli not in exhausted}
            available = [cli for cli, remaining in untried.items() if remaining is not None and remaining > reserve]
            # A Codex read-only role may run shell checks in its isolated
            # scratch workspace. Claude tools alone cannot enforce that boundary.
            if not role.can_write and "codex" in exhausted and "claude" in available:
                available.remove("claude")
                print(f"syndicate: cannot retry {role.name} on claude with the Codex read-only workspace restrictions.",
                      file=sys.stderr)
            if not available:
                if all(remaining is not None and remaining <= reserve for remaining in untried.values()):
                    try:
                        held = hold_role_task(project, owner, role, sorted(providers))
                    except OSError as error:
                        raise SyndicateError(f"could not put the task on hold: {error}; "
                                             "if sandboxed, retry this run-role command outside the sandbox with approval") from error
                    if held:
                        print(f"syndicate: task is on hold after hitting usage limits for {role.name}.", file=sys.stderr)
                        return 75
                    print(f"syndicate: usage limits exhausted for {role.name}; no active owning task was placed on hold.",
                          file=sys.stderr)
                elif any(remaining is None for remaining in untried.values()):
                    missing = ", ".join(cli for cli, remaining in untried.items() if remaining is None)
                    print(f"syndicate: no fallback with known usage available for {role.name}; "
                          f"no usage reading for {missing}.", file=sys.stderr)
                if isinstance(failure, SyndicateError):
                    raise failure
                print(f"syndicate: {failure}", file=sys.stderr)
                return failure.exit_code
            ranks = {cli: runtime.readings_by_kind(runtime.read_json(runtime.STATE / f"{cli}.json"))
                     for cli in available}
            provider = runtime.choose_engine(None, readings, reserve, available, ranks)
            print(f"syndicate: {failure}; retrying {role.name} on {provider} "
                  f"({readings[provider]:g}% last recorded remaining).", file=sys.stderr)
        attempt = copy(role)
        attempt.cli = provider
        try:
            specialist_gate(attempt, reserve if launch_reserve is not None else None, cwd=project)
            with ExitStack() as stack:
                enter_specialist_lease(stack, project, team, attempt)
                attempt_brief = brief
                if exhausted:
                    attempt_brief += ("\n\nAn earlier attempt hit a provider usage limit. Inspect the existing "
                                      "state and continue any partial work. Verify whether earlier actions "
                                      "completed before repeating them.")
                result = launch_role(project, team, attempt, attempt_brief, reserve=run_reserve)
        except runtime.RoleUsageLimit as error:
            failure = error
            exhausted.add(provider)
            continue
        if result == 0:
            print(f"Syndicate specialist completed: {role.name} {provider} {uuid.uuid4().hex}")
        return result


RUN_RECORD_MAX_BYTES = 1 << 20  # run.json holds the task text; anything larger is not a record we wrote


def read_run_record(project: Path) -> tuple[str, dict | None]:
    """('missing' | 'invalid' | 'valid', record) for .syndicate/run.json.

    Opened without following symbolic links (neither .syndicate nor run.json)
    and non-blocking; it must be a regular file owned by this user, at most
    RUN_RECORD_MAX_BYTES, holding a JSON object whose id matches the
    supervisor's run-id format. Never creates or modifies anything.
    """
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        directory = os.open(Path(project) / LOCAL, flags | getattr(os, "O_DIRECTORY", 0))
    except FileNotFoundError:
        return "missing", None
    except OSError:
        return "invalid", None
    try:
        try:
            fd = os.open("run.json", flags | getattr(os, "O_NONBLOCK", 0), dir_fd=directory)
        except FileNotFoundError:
            return "missing", None
        except OSError:
            return "invalid", None
        try:
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_size > RUN_RECORD_MAX_BYTES):
                return "invalid", None
            raw = os.read(fd, RUN_RECORD_MAX_BYTES + 1)
        except OSError:
            return "invalid", None
        finally:
            os.close(fd)
    finally:
        os.close(directory)
    try:
        record = json.loads(raw)
    except (ValueError, UnicodeDecodeError, RecursionError):
        return "invalid", None
    run_id = record.get("id") if isinstance(record, dict) else None
    return ("valid", record) if len(raw) <= RUN_RECORD_MAX_BYTES and runtime.valid_run_id(run_id) else ("invalid", None)


def session_lock_state(project: Path) -> str:
    """'held' | 'free' | 'missing' | 'unknown' for the project's session.lock.

    Uses the validated open of portfolio.open_lock (no symbolic links or
    FIFOs, regular file owned by this user, single link), never creates or
    truncates the file, and only attempts a momentary shared non-blocking
    lock, released at once: 'held' means a supervisor owns the project.
    """
    import fcntl
    try:
        fd, _ = portfolio.open_lock(project_lock_path(project))
    except FileNotFoundError:
        return "missing"
    except OSError:
        return "unknown"
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return "held"
        except OSError:
            return "unknown"
        fcntl.flock(fd, fcntl.LOCK_UN)
        return "free"
    finally:
        os.close(fd)


def supervised_run_id(project: Path, role: Role, problem: str) -> str | None:
    """Run id of the live supervised run of project when SYNDICATE_RUN_ID is unusable.

    A run is live while its supervisor holds session.lock; .syndicate/run.json
    then names it (run ids are not secret). None means no supervised run is
    live. Raises SyndicateError (fail closed) when one may be live but its id
    or the lock state cannot be established.
    """
    # Probe, read, probe: a supervisor that exits and is replaced between the
    # read and a single probe would otherwise lend this lease a stale run id.
    lock = session_lock_state(project)
    state, record = read_run_record(project)
    if state == "missing":
        return None
    if lock == "held":
        lock = session_lock_state(project)
    if lock in ("free", "missing"):
        return None
    refused = (f"refusing to launch the {role.name} specialist, so no {role.cli} CLI was launched: "
               f"{runtime.RUN_ENV} {problem}, and ")
    if lock == "unknown":
        raise SyndicateError(refused + f"the state of {project_lock_path(project)} cannot be determined, so "
                             "Syndicate cannot tell whether a supervised run is live and would enforce the "
                             f"{role.cli} reserve. Check that file (it must be a regular file owned by you), "
                             f"or make sure {runtime.RUN_ENV} reaches run-role (for Codex, its "
                             "shell_environment_policy must keep it).")
    if state != "valid":
        raise SyndicateError(refused + f"a supervised run holds {project_lock_path(project)} but "
                             f"{Path(project) / LOCAL / 'run.json'} does not name a valid run id, so the lease "
                             f"could not be attributed to it. Make sure {runtime.RUN_ENV} reaches run-role "
                             "(for Codex, its shell_environment_policy must keep it).")
    return record["id"]


def specialist_run_reserve(project: Path, launch_reserve: float | None) -> float | None:
    """Use the live supervisor's one-run reserve override when present."""
    if launch_reserve is None:
        return None
    state, record = read_run_record(project)
    if state == "valid":
        reserve = record.get("reserve")
        if type(reserve) in (int, float) and 0 < reserve < 100 and session_lock_state(project) == "held":
            return float(reserve)
    return launch_reserve


def enter_specialist_lease(stack: ExitStack, project: Path, team: Team, role: Role) -> None:
    """Record the locally enforced specialist against its supervising run.

    With handoff on, the lease names the supervised run: SYNDICATE_RUN_ID
    (set by the supervisor) or, if that is missing or malformed (for example,
    stripped by a Codex shell_environment_policy), the live run found through
    run.json and a held session.lock (supervised_run_id). With no supervised
    run live, no lease is written. A failure to record a supervised lease
    refuses the launch rather than running an untracked specialist.
    """
    if team.config["handoff"] == "off":
        return
    provider = role.cli
    run_id = os.environ.get(runtime.RUN_ENV, "")
    if not runtime.valid_run_id(run_id):
        detail = "is not set" if not run_id else "is malformed"
        found = supervised_run_id(project, role, detail)
        if found is None:
            print(f"syndicate: WARNING: {runtime.RUN_ENV} {detail} and no Syndicate-supervised run is live "
                  f"for this project; {role.name} will enforce the {provider} reserve locally without a lease.",
                  file=sys.stderr)
            return
        print(f"syndicate: {runtime.RUN_ENV} {detail}; using run id {found} from "
              f"{Path(project) / LOCAL / 'run.json'} (its supervisor holds the session lock) for the "
              f"{role.name} specialist lease.", file=sys.stderr)
        run_id = found
    try:
        stack.enter_context(runtime.specialist_lease(project, provider, role.name, run_id, local_quota=True))
    except (OSError, ValueError) as error:
        raise SyndicateError(
            f"cannot record the {role.name} specialist lease in {runtime.lease_directory(project)}: {error}; "
            f"refusing to launch the specialist, so no {provider} CLI was launched. The supervisor uses the "
            "lease to track its specialists. If a sandbox denied the write, rerun this "
            "exact run-role command outside the sandbox with approval.") from error


def launch_role(project: Path, team: Team, role: Role, brief: str, *, reserve: float | None) -> int:
    if role.cli == "claude":
        argv = ["claude", "-p", "--agents", json.dumps({role.name: claude_agent(role)}), "--agent", role.name]
        if role.can_write:
            argv += ["--permission-mode", "acceptEdits"]
        configured_format = cli_value(team.config.get("claude-output-format", "false"))
        claude_text = configured_format is False or configured_format == "text"
        config = team.config
        if claude_text:
            config = {**config, "claude-output-format": "json"}
        argv += cli_options('claude', config) + ['--', brief]
        return runtime.run_specialist_process(
            argv, cwd=project, reserve=reserve, claude_text=claude_text,
            structured_stdout=claude_text or configured_format in ("json", "stream-json"))
    else:
        # Keep reviewers' repository read-only while allowing test fixtures and
        # bytecode in a disposable workspace outside the repository. Native
        # read-only roles use this same path through a relay.
        scratch_parent = REGISTRY_PATH.parent / "portfolio" / "scratch"
        try:
            scratch_parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            scratch_dir = tempfile.TemporaryDirectory(prefix=f"{role.name}-", dir=scratch_parent)
        except OSError as error:
            raise SyndicateError(f"cannot create specialist scratch workspace: {error}; "
                                 "rerun this run-role command outside the sandbox with approval") from error
        with scratch_dir as scratch:
            cwd = project if role.can_write else Path(scratch)
            instructions = role.body + (f"\n\nSource project: {project}. Run source checks there; "
                f"use {scratch} for all temporary files and test outputs. "
                "Do not edit source files. Before reviewing, read applicable AGENTS.md and "
                "AGENTS.override.md instructions in the source project's ancestors and root, "
                "then read nested instruction files applicable to each reviewed source file. "
                "The scratch working directory does not discover source project instructions automatically."
                if not role.can_write else "")
            argv = ["codex", "exec", "--skip-git-repo-check", "-C", str(cwd),
                    "-s", "workspace-write",
                    "-c", "sandbox_workspace_write.exclude_slash_tmp=true",
                    "-c", "sandbox_workspace_write.exclude_tmpdir_env_var=true",
                    "--add-dir", scratch,
                    "-c", f"developer_instructions={jstr(instructions)}"]
            if role.can_write:
                argv += ["--add-dir", str(REGISTRY_PATH.parent / "portfolio")]
            argv += cli_options('codex', team.config) + ['--', brief]
            env = dict(os.environ, TMPDIR=scratch, PYTHONDONTWRITEBYTECODE="1")
            return runtime.run_specialist_process(argv, cwd=cwd, env=env, reserve=reserve)


def forget_reading(provider: str) -> int:
    """Remove one provider's recorded usage reading, and nothing else.

    Explicit operator recovery for a reading known to be outdated; Syndicate
    never forgets a reading or infers a reset by itself.
    """
    path = runtime.STATE / f"{provider}.json"
    try:
        directory = os.open(runtime.STATE, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        print(f"No {provider} usage reading is recorded ({path} does not exist); nothing removed.")
        return 0
    except OSError as error:
        raise SyndicateError(f"cannot open {runtime.STATE} safely: {error}") from None
    try:
        try:
            info = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            print(f"No {provider} usage reading is recorded ({path} does not exist); nothing removed.")
            return 0
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            raise SyndicateError(f"refusing to remove {path}: it is not a regular file")
        os.unlink(path.name, dir_fd=directory)
    except OSError as error:
        raise SyndicateError(f"cannot remove {path}: {error}") from None
    finally:
        os.close(directory)
    print(f"Removed {path}. The {provider} reserve cannot be enforced until a new {provider} usage reading "
          "is recorded.")
    return 0


def cmd_limits(args: argparse.Namespace) -> int:
    if getattr(args, "forget", None):
        return forget_reading(args.forget)
    if args.stop:
        runtime.STATE.mkdir(parents=True, exist_ok=True)
        (runtime.STATE / "stop").touch()
        print("Limit monitor stop requested; agent sessions are unaffected.")
        return 0
    notices = runtime.STATE / "notifications.log"
    try:
        offset = 0
        if args.watch:
            try:
                offset = notices.stat().st_size
            except FileNotFoundError:
                pass
        runtime.start_monitor(SCRIPT)
        while True:
            print(runtime.describe_limits())
            if not args.watch:
                return 0
            try:
                with notices.open() as f:
                    f.seek(offset)
                    sys.stderr.write(f.read())
                    offset = f.tell()
            except FileNotFoundError:
                pass
            time.sleep(5)
    except KeyboardInterrupt:
        return 0


def cmd_init(args: argparse.Namespace) -> int:
    project = register_workspace(execution_project(args.dir))
    local = project / LOCAL
    (local / "roles").mkdir(parents=True, exist_ok=True)
    config = project_config_path(project)
    if config.exists():
        print(f"kept existing {config}")
    else:
        config.write_text(CONFIG_TEMPLATE)
        print(f"created {config}")
    print(f"created {local / 'roles'}/ (drop role overrides here; see docs/configuration.md)")
    note = ensure_excluded(project)
    print(note or f"{LOCAL}/ is excluded from git via .git/info/exclude")
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    if args.global_ and args.local:
        raise SyndicateError("--global and --local cannot be used together")
    if args.global_:
        sys.stdout.write(render_global_config())
        return 0
    if args.dir:
        project = register_workspace(Path(args.dir).expanduser().resolve())
    else:
        project = latest_status_project()
    sys.stdout.write(render_config(resolve_team(project), args.local))
    return 0


def cmd_setup_codex_gate(args: argparse.Namespace) -> int:
    path = Path.home() / ".codex" / "hooks.json"
    data = json.loads(path.read_text()) if path.is_file() else {}
    command = shlex.quote(str(GATE_SCRIPT))
    stop = [e for e in data.get("hooks", {}).get("Stop", [])
            if not any(h.get("command") == command for h in e.get("hooks", []))]
    if not args.remove:
        stop.append({"hooks": [{"type": "command", "command": command}]})
    hooks = data.setdefault("hooks", {})
    if stop:
        hooks["Stop"] = stop
    else:
        hooks.pop("Stop", None)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    if args.remove:
        print(f"removed the review-gate hook from {path}")
    else:
        print(f"installed the review-gate hook in {path}")
        print("Codex runs it only after you approve it once: open 'codex' and accept the hook review prompt.")
    return 0


def cmd_tasks(args: argparse.Namespace) -> int:
    rows = gather_statuses()
    tasks = [(r, t) for r in rows for t in r["tasks"] + r["completed_tasks"] + r.get("ended_tasks", [])]
    if args.action == "list":
        if args.project:
            target = str(resolve_project(args.project))
            tasks = [(r, t) for r, t in tasks if r["path"] == target]
        if args.json:
            print(json.dumps([{**t, "project_path": r["path"], "project_name": r["name"]} for r, t in tasks], indent=2))
            return 0
        for row, task in tasks:
            state = task.get('state', 'unknown') + (" (unverified)" if task.get("liveness") == "unknown" else "")
            print(f"{task['id']}  [{state}] {row['name']}  {task.get('summary', '')}\n  source: {task['source_path']}")
            if task.get("state") == ENDED:
                print(f"  ended: {task.get('end_reason') or 'session ended'} (was {task.get('last_state') or 'unknown'})")
        return 0
    matches = [(r, t) for r, t in tasks if t.get("id") == args.task_id and
               (not args.source or t["source_path"] == str(Path(args.source).expanduser().resolve()))]
    if len(matches) != 1:
        raise SyndicateError("task not found or ambiguous; use tasks list and --source <directory>")
    _, task = matches[0]
    changes = {}
    if args.project:
        target = resolve_project(args.project)
        if args.project != "generic":
            register_project(target)
        changes.update(project_path=str(target), needs_project=False)
    if args.summary is not None:
        if not args.summary.strip():
            raise SyndicateError("task summary cannot be empty")
        changes["summary"] = args.summary
    if args.state:
        changes["state"] = args.state
        changes["completed_at"] = now_iso() if args.state == "done" else None
        if args.state == ENDED:
            changes.update(ended_at=now_iso(), end_reason="closed manually",
                           last_state=task.get("last_state") if task.get("state") == ENDED else task.get("state"))
        else:
            changes.update(ended_at=None, end_reason=None)
    if not changes:
        raise SyndicateError("provide --project, --summary, or --state")
    changes["updated_at"] = now_iso()
    # An independent overlay cannot be overwritten by an active agent's status writes.
    with registry_lock():
        path = REGISTRY_PATH.parent / "task-edits.json"
        edits = runtime.read_json(path)
        edits.setdefault(task["source_path"], {}).setdefault(task["id"], {}).update(changes)
        runtime.atomic_json(path, edits)
    print(f"Updated task {task['id']}")
    return 0


def build_parsers() -> tuple[argparse.ArgumentParser, argparse.ArgumentParser]:
    run = argparse.ArgumentParser(
        prog="syndicate team task",
        description="Run a project team on its configured CLI.",
        epilog="Team commands: init (initialize a project), task (run a task), "
               "run-role (run a specialist). Use syndicate team COMMAND --help for details.",
    )
    run.add_argument("-x", "--runtime", choices=CLIS, help="CLI hosting the orchestrator (overrides project config)")
    run.add_argument("--project", help="project repo name/path, or generic (default: current directory)")
    run.add_argument("-p", "--print", action="store_true", help="run headless and print the result")
    run.add_argument("--reserve", type=float, help="handoff when this percentage of account usage remains (default: 10)")
    run.add_argument("--handoff", dest="handoff_path", help="continue from a saved handoff directory")
    run.add_argument('--no-live', action='store_true', help='disable automatic portfolio inbox delivery for this run')
    run.add_argument('--inbox-interval', type=int, help='polling interval in minutes (default: 5; must divide 60)')
    run.add_argument('--inbox-transport', choices=('auto', 'poll', 'channel'), help='auto: Codex queue / Claude scheduled poll')
    run.add_argument("--all-runtime", choices=CLIS, help="use this CLI for every specialist in this run (combine with -x)")
    run.set_defaults(dir=".")
    run.add_argument("rest", nargs=argparse.REMAINDER, help="the task, then any extra args for the CLI")

    sub = argparse.ArgumentParser(
        prog="syndicate",
        description="Open Chief of Staff for a greeting, portfolio briefing, and conversational next steps. "
                    "Use -x codex or -x claude to choose its CLI. Project work lives under syndicate team.",
        epilog="Examples: syndicate | syndicate -x codex | syndicate team task --project /repo 'task' | "
               "syndicate list workers | syndicate show chief-of-staff | syndicate team init",
    )
    sub.add_argument('-x', '--runtime', choices=CLIS, help='Chief of Staff CLI')
    cmds = sub.add_subparsers(dest="cmd", required=True)
    team_parser = cmds.add_parser('team', help='initialize a project or execute a task')
    team_actions = team_parser.add_subparsers(dest='action', required=True)
    task_parser = team_actions.add_parser('task', parents=[run], add_help=False, help='run a project task')
    task_parser.set_defaults(fn=cmd_task)
    p = cmds.add_parser("chief-of-staff", help="run the cross-project Chief of Staff separately from project teams")
    p.add_argument("-x", "--runtime", choices=CLIS)
    p.add_argument("-p", "--print", action="store_true", help="run headless and print the result")
    p.add_argument("--reserve", type=float, default=10, help="account usage reserve percentage (default: 10)")
    p.add_argument("--handoff", dest="handoff_path", help="resume a saved Chief of Staff handoff")
    p.add_argument("--dry-run", action="store_true", help="print launch arguments without starting a CLI or writing state")
    p.add_argument('--no-live', action='store_true', help='disable automatic portfolio inbox delivery for this run')
    p.add_argument('--inbox-interval', type=int, help='polling interval in minutes (default: 5; must divide 60)')
    p.add_argument('--inbox-transport', choices=('auto', 'poll', 'channel'), help='auto: Codex queue / Claude scheduled poll')
    p.add_argument("task", nargs="?")
    p.set_defaults(fn=cmd_chief_of_staff)
    p = cmds.add_parser("briefs", help="durable project goals, priorities and context")
    actions = p.add_subparsers(dest="action", required=True)
    for action in ("list", "show", "update"):
        command = actions.add_parser(action)
        command.add_argument("--json", action="store_true")
        if action != "list":
            command.add_argument("--project", required=True)
        if action == "update":
            command.add_argument("--goal")
            command.add_argument("--priority", choices=("low", "normal", "high", "critical"))
            for flag, field in (("constraint", "constraints"), ("decision", "decisions"),
                                ("dependency", "dependencies"), ("next-step", "next_steps")):
                command.add_argument("--" + flag, dest=field, action="append")
            command.add_argument("--clear", action="append", default=[],
                                 choices=("goal", "priority", *portfolio.BRIEF_LIST_FIELDS))
            command.add_argument("--revision", type=int, help="require this brief revision (0 for new)")
        command.set_defaults(fn=cmd_briefs)
    p = cmds.add_parser("sessions", help="inspect project orchestrator ownership")
    p.add_argument("--project")
    p.add_argument("--all", action="store_true", help="include earlier sessions")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_sessions)
    p = cmds.add_parser('live', help='bind or inspect the current managed live inbox')
    actions = p.add_subparsers(dest='action', required=True)
    for action in ('attach', 'status', 'poll', 'seen', 'scheduled'):
        command = actions.add_parser(action)
        command.add_argument('-C', '--dir', default='.')
        if action == 'seen':
            command.add_argument('event_ids', nargs='+')
        if action == 'scheduled':
            command.add_argument('job_id')
        command.set_defaults(fn=cmd_live)
    p = cmds.add_parser('messages', help='project messages to the Chief of Staff')
    actions = p.add_subparsers(dest='action', required=True)
    command = actions.add_parser('list')
    command.add_argument('--all', action='store_true')
    command.add_argument('--json', action='store_true')
    command.set_defaults(fn=cmd_messages)
    command = actions.add_parser('acknowledge')
    command.add_argument('message_id')
    command.set_defaults(fn=cmd_messages)
    command = actions.add_parser('send')
    command.add_argument('message')
    command.add_argument('--key', required=True)
    command.add_argument('-C', '--dir', default='.')
    command.add_argument('--task')
    command.add_argument('--session', required=True)
    command.set_defaults(fn=cmd_messages)
    p = cmds.add_parser("requests", help="durable task-scoped requests to project orchestrators")
    actions = p.add_subparsers(dest="action", required=True)
    listing = actions.add_parser("list")
    listing.add_argument("--project")
    listing.add_argument("-C", "--dir")
    listing.add_argument("--task")
    listing.add_argument("--all", action="store_true")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(fn=cmd_requests)
    send = actions.add_parser("send")
    send.add_argument("message")
    send.add_argument("--key", required=True)
    send.add_argument("-C", "--dir", default=".")
    send.add_argument("--task")
    send.set_defaults(fn=cmd_requests)
    for action in ("acknowledge", "fail", "cancel", "retry"):
        command = actions.add_parser(action)
        command.add_argument("request_id")
        if action not in ("cancel", "retry"):
            command.add_argument("-C", "--dir", default=".")
            command.add_argument("--task")
            command.add_argument("--session", required=True, help="owning session token from launch status")
            command.add_argument("--note", required=True)
        command.set_defaults(fn=cmd_requests)
    p = cmds.add_parser("briefing", help="Chief of Staff cross-project briefing")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_briefing)
    p = cmds.add_parser("decisions", help="shared cross-project decision inbox")
    actions = p.add_subparsers(dest="action", required=True)
    listing = actions.add_parser("list")
    listing.add_argument("--all", action="store_true", help="include resolved and withdrawn decisions")
    listing.add_argument("--project")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(fn=cmd_decisions)
    request = actions.add_parser("request")
    request.add_argument("question")
    request.add_argument("--key", required=True, help="stable question key within the owning task")
    request.add_argument("-C", "--dir", default=".")
    request.add_argument("--task", help="owning task ID; defaults to current task")
    request.add_argument("--context", default="")
    request.add_argument("--option", action="append", default=[])
    request.add_argument("--recommendation", default="")
    request.add_argument("--blocking", action="store_true")
    request.add_argument("--deadline", help="explicit deadline, if supplied by the requester")
    request.set_defaults(fn=cmd_decisions)
    for action in ("answer", "acknowledge", "withdraw"):
        command = actions.add_parser(action)
        command.add_argument("decision_id")
        if action == "answer":
            command.add_argument("answer")
        if action == "acknowledge":
            command.add_argument("-C", "--dir", default=".")
            command.add_argument("--task", help="owning task ID; defaults to current task")
            command.add_argument("--answer-revision", type=int, required=True,
                                 help="answer_revision incorporated by the owning team")
        command.set_defaults(fn=cmd_decisions)
    p = cmds.add_parser("tasks", help="list, edit, create worktrees for, clean up merged PRs and close project tasks")
    actions = p.add_subparsers(dest="action", required=True)
    listing = actions.add_parser("list")
    listing.add_argument("--project", help="repo name/path or generic")
    listing.add_argument("--json", action="store_true", help="include IDs, source paths, and assignment metadata")
    listing.set_defaults(fn=cmd_tasks)
    close = actions.add_parser('close', help='atomically close the owned task in the status overlay and notify Chief of Staff')
    close.add_argument('task_id')
    close.add_argument('-C', '--dir', default='.')
    close.add_argument('--session', required=True)
    close.add_argument('--state', required=True, choices=('done', 'ended', 'waiting_on_user', 'blocked'))
    close.add_argument('--progress', required=True)
    close.add_argument('--message', required=True)
    close.add_argument('--implementation', action='append', nargs=3, metavar=('ROLE', 'PROVIDER', 'PARTICIPANT_ID'),
                       help='specialist that performed implementation; repeat to report multiple participants')
    close.add_argument('--review', action='append', nargs=3, metavar=('ROLE', 'PROVIDER', 'PARTICIPANT_ID'),
                       help='independent specialist that performed review and verification; repeat as needed')
    close.add_argument('--role-blocker', nargs=2, metavar=('ROLE', 'REASON'),
                       help='required specialist that could not start; use with --state blocked')
    close.set_defaults(fn=cmd_tasks_close)
    cleanup = actions.add_parser("cleanup-pr", help="verify the task PR merge and clean its Git artifacts")
    cleanup.add_argument("number", type=int, help="task PR number on origin")
    cleanup.add_argument("-C", "--dir", default=".", help="repository checkout outside the task worktree")
    cleanup.add_argument("--branch", required=True, help="recorded task branch")
    cleanup.add_argument("--worktree", required=True, help="absolute path to the recorded linked worktree")
    cleanup.add_argument("--task", help="task running the cleanup; defaults to the current task of the worktree's source")
    cleanup.set_defaults(fn=cmd_tasks_cleanup_pr)
    worktree = actions.add_parser("worktree", help="create or re-adopt the task's durable, locked Git worktree and print its path")
    worktree.add_argument("task_id")
    worktree.add_argument("-C", "--dir", default=".", help="launch source containing .syndicate/status.json")
    worktree.add_argument("--repo", help="repository checkout to branch from (default: the -C directory)")
    worktree.add_argument("--branch", required=True, help="task branch, for example work/<topic>-<task>")
    worktree.add_argument("--series", help="task series sharing this worktree (default: the branch name)")
    worktree.add_argument("--base", help="start point for a new branch (default: origin/main, else main, else HEAD)")
    worktree.add_argument("--json", action="store_true", help="print the registry entry instead of the path")
    worktree.set_defaults(fn=cmd_tasks_worktree)
    edit = actions.add_parser("edit")
    edit.add_argument("task_id")
    edit.add_argument("--source", help="source directory, required for ambiguous task IDs")
    edit.add_argument("--project", help="assign to repo name/path or generic")
    edit.add_argument("--summary")
    edit.add_argument("--state", choices=("queued", "running", "waiting_on_user", "on_hold", "blocked", "failed", "done", ENDED),
                      help="ended: closed without completion (use done only for finished work)")
    edit.set_defaults(fn=cmd_tasks)
    p = team_actions.add_parser("init", help="create .syndicate/ in a project and exclude it from git")
    p.add_argument("--project", dest="dir", default=".")
    p.set_defaults(fn=cmd_init)
    p = cmds.add_parser("config", help="show the merged settings, or every layer with --local")
    p.add_argument("-C", "--dir", help="project directory (default: project whose status was updated last)")
    p.add_argument("--local", action="store_true",
                   help="show every layer read for this project, including overridden keys; * marks .syndicate/syndicate.conf")
    p.add_argument("--global", dest="global_", action="store_true",
                   help="print only the user-wide syndicate.conf")
    p.set_defaults(fn=cmd_config)
    p = team_actions.add_parser("run-role", help="run one role headlessly on its configured CLI (used by relay agents)")
    p.add_argument("role")
    provider = p.add_mutually_exclusive_group()
    provider.add_argument("--runtime", choices=CLIS, help="start with the runtime resolved by the parent session")
    provider.add_argument("--backoff-from", choices=CLIS, help="retry after this provider reported an account usage limit")
    p.add_argument("brief", help="the task, or - to read it from stdin")
    p.add_argument("--project", dest="dir", default=".")
    p.set_defaults(fn=cmd_run_role)
    p = cmds.add_parser("setup-codex-gate", help="install the review-gate hook into ~/.codex/hooks.json (once)")
    p.add_argument("--remove", action="store_true")
    p.set_defaults(fn=cmd_setup_codex_gate)
    p = cmds.add_parser("dashboard", help="live console view of every registered project's status")
    p.add_argument("--interval", type=float, default=2.0, help="seconds between refreshes (default: 2)")
    p.add_argument("--once", action="store_true", help="render once and exit (for scripting)")
    p.add_argument("--project", help="show a project by exact name or repo path")
    p.add_argument("--list", action="store_true", help="list registered project names and paths")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto",
                   help="terminal colors (default: auto; respects NO_COLOR)")
    p.add_argument("--details", action="store_true", help="show full project paths and task details")
    p.set_defaults(fn=cmd_dashboard)
    p = cmds.add_parser("web", help="local browser dashboard (http://127.0.0.1:<port>/)")
    p.add_argument("--port", type=int, default=8765)
    p.set_defaults(fn=cmd_web)
    p = cmds.add_parser("limits", help="show account limits and reset notifications; starts the background monitor")
    p.add_argument("--watch", action="store_true", help="keep displaying limits and reset notices")
    p.add_argument("--stop", action="store_true", help="stop the background monitor")
    p.add_argument("--forget", choices=("claude", "codex"), metavar="PROVIDER",
                   help="remove the recorded usage reading of PROVIDER (claude or codex) when you know it is "
                        "outdated; the reserve cannot be enforced for it until a new reading is recorded")
    p.set_defaults(fn=cmd_limits)
    p = cmds.add_parser('list', help='list windows in the syndicate tmux session')
    list_actions = p.add_subparsers(dest='action', required=True)
    workers = list_actions.add_parser('workers', help='list open workers')
    workers.add_argument('--json', action='store_true')
    workers.set_defaults(fn=cmd_list_workers)
    p = cmds.add_parser('show', help='show one worker, or several side by side')
    p.add_argument('workers', nargs='+', help='worker window names; two are side by side, three or more are tiled')
    p.set_defaults(fn=cmd_show_workers)
    p = cmds.add_parser('attach', help='attach to the syndicate session')
    p.set_defaults(fn=cmd_attach_workers)
    p = cmds.add_parser('message', help='type a message into a running worker')
    p.add_argument('worker')
    p.add_argument('text', nargs='+', help='words to type; Enter is pressed unless --no-submit is set')
    p.add_argument('--no-submit', action='store_true', help='type the text without pressing Enter')
    p.set_defaults(fn=cmd_message_worker)
    p = cmds.add_parser('capture', help='print recent output from a worker without attaching')
    p.add_argument('worker')
    p.add_argument('--lines', type=int, default=100, help='lines of pane history to print (default: 100)')
    p.set_defaults(fn=cmd_capture_worker)
    p = cmds.add_parser('close', help='close a worker window')
    p.add_argument('worker')
    p.add_argument('--force', action='store_true', help='close chief-of-staff; without this, the Chief is refused')
    p.set_defaults(fn=cmd_close_worker)
    p = cmds.add_parser('detach', help='detach from the syndicate session and restore side-by-side workers')
    p.set_defaults(fn=cmd_detach_workers)
    return run, sub


def main(argv: list[str]) -> int:
    inside_tmux = bool(argv and argv[0] == '_in-tmux')
    if inside_tmux:
        argv = argv[1:]
    if argv and argv[0] == '_restore-view':
        socket = None
        if len(argv) == 3 and argv[1] == '--socket':
            socket = argv[2]
        elif len(argv) != 1:
            print('syndicate: usage: _restore-view [--socket NAME]', file=sys.stderr)
            return 2
        try:
            restore_worker_view(socket=socket)
        except (SyndicateError, portfolio.PortfolioError) as e:
            print(f'syndicate: {e}', file=sys.stderr)
            return 1
        return 0
    original_argv = list(argv)
    if not argv:
        argv = ['chief-of-staff']
    if argv and argv[0] == "_claude-usage":
        args = argv[1:]
        capture = None
        while args:
            if len(args) >= 2 and args[0] == "--state":
                runtime.STATE = Path(args[1])
                args = args[2:]
            elif len(args) >= 2 and args[0] == "--capture":
                capture = Path(args[1])
                args = args[2:]
            else:
                print("syndicate: usage: _claude-usage [--state DIR] [--capture FILE]", file=sys.stderr)
                return 2
        try:
            raw = sys.stdin.read()
            if capture is not None:
                try:
                    capture.write_text(raw)
                except OSError:
                    pass
            observation = runtime.save_observation("claude", json.loads(raw))
            state, remaining = runtime.availability(observation)
            print(f"Syndicate: Claude {remaining:g}% account usage remaining" if remaining is not None else f"Syndicate: Claude usage {state}")
            return 0
        except (OSError, ValueError, TypeError, AttributeError):
            print("Syndicate: Claude usage unknown")
            return 0
    if argv == ["_limits-monitor"]:
        return runtime.monitor_forever()
    run, sub = build_parsers()
    try:
        if argv[0] in ("team", "config", "setup-codex-gate", "dashboard", "web", "limits", "tasks", "decisions", "briefing", "briefs", "sessions", "requests", "chief-of-staff", "live", "messages", "list", "show", "attach", "capture", "close", "detach", "message"):
            args = sub.parse_args(argv)
        elif argv[0] in ('-h', '--help'):
            sub.parse_args(argv)
        else:
            args = sub.parse_args(['chief-of-staff', *argv])
        if args.fn in (cmd_task, cmd_run_role, cmd_chief_of_staff) and not getattr(args, 'dry_run', False) and not inside_tmux and not (args.fn == cmd_run_role and os.environ.get('TMUX')) and tmux_enabled():
            if args.fn == cmd_chief_of_staff:
                # Detect a direct or tmux owner before starting another CLI.
                # The child acquires the lifetime lock too, closing launch races.
                with chief_session_lock(probe=True):
                    pass
                directory = REGISTRY_PATH.parent / 'portfolio' / 'workspace'
                directory.mkdir(parents=True, exist_ok=True)
                name = CHIEF_TMUX_WINDOW
            else:
                project = getattr(args, 'project', None)
                directory = execution_project(project or getattr(args, 'dir', '.'))
                name = re.sub(r'[^\w-]', '-', directory.name)
                if args.fn == cmd_task:
                    rows = assignment_rows()  # one sweep, reused for every live session
                    for session in coordination_store().snapshot()['sessions']:
                        if session['live'] and (session['source_path'] == str(directory)
                                                or task_project(Path(session['source_path']), session['task_id'], rows) == str(directory)):
                            print(f"Team already running: {session['id']} / task {session['task_id']}")
                            return 0
                else:
                    name += '-' + args.role + '-' + uuid.uuid4().hex[:8]
                    if args.brief == '-':
                        # Materialize piped briefs before detaching from the terminal.
                        brief = sys.stdin.read()
                        original_argv = ['team', 'run-role', args.role, '--project', str(directory)]
                        if args.runtime:
                            original_argv += ['--runtime', args.runtime]
                        if args.backoff_from:
                            original_argv += ['--backoff-from', args.backoff_from]
                        original_argv += ['--', brief]
            return launch_tmux(original_argv, directory, name,
                               headless=getattr(args, 'print', False) or args.fn == cmd_run_role)
        args.inside_tmux = inside_tmux
        return args.fn(args)
    except (SyndicateError, portfolio.PortfolioError) as e:
        print(f"syndicate: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
