#!/usr/bin/env python3
"""syndicate: run a team of role-based coding agents on Claude Code and/or Codex CLI.

Global roles live in <repo>/roles. Each project can override them, and choose
which CLI runs each role, from an untracked <project>/.syndicate/ directory.
User-wide settings in $XDG_CONFIG_HOME/syndicate/syndicate.conf (or
~/.config/syndicate/syndicate.conf) apply first; a project key replaces that
one key. Nothing is written anywhere else in the project. See README.md and
docs/configuration.md.
"""
from __future__ import annotations

import argparse
import errno
import http.server
import json
import os
